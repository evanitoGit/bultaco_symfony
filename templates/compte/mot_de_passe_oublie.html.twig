{% extends 'base.html.twig' %}

{% block title %}{{ 'compte.menu.mot_de_passe_oublie'|trans }} - {{ 'meta.suffixe'|trans }}{% endblock %}
{% block body_class %}page-login{% endblock %}

{% block body %}
    <div class='head'>
        <h1>{{ 'compte.menu.mon_compte'|trans }}</h1>
    </div>

    <div class='container'>
        <section class='login-section'>
            {{ form_start(form, { attr: { class: 'login-box commande-form', novalidate: 'novalidate' } }) }}
                <img src="{{ asset('img/logo_rond.png') }}" alt='' class='login-logo'>
                <h2 class='login-title'>{{ 'compte.menu.mot_de_passe_oublie'|trans }}</h2>
                <p class='login-subtitle'>{{ 'compte.oubli.sous_titre'|trans }}</p>

                {% include 'compte/_flashes.html.twig' %}
                {{ form_errors(form) }}
                {{ form_row(form.email) }}

                <button class='btn-login' type='submit'>{{ 'compte.oubli.bouton'|trans }}</button>

                <p class='login-alternative'>
                    <a href='{{ path('app_compte_connexion') }}'>{{ icone('fleche-gauche') }} {{ 'compte.oubli.retour_connexion'|trans }}</a>
                </p>
            {{ form_end(form) }}
        </section>
    </div>
{% endblock %}
