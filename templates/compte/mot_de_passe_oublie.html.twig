{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - Club Bultaco{% endblock %}
{% block body_class %}page-login{% endblock %}

{% block body %}
    <div class='head'>
        <h1>Mon compte</h1>
    </div>

    <div class='container'>
        <section class='login-section'>
            {{ form_start(form, { attr: { class: 'login-box commande-form', novalidate: 'novalidate' } }) }}
                <img src="{{ asset('img/logo_rond.png') }}" alt='' class='login-logo'>
                <h2 class='login-title'>Mot de passe oublié</h2>
                <p class='login-subtitle'>Indiquez l'adresse de votre compte : nous vous enverrons un lien pour choisir un nouveau mot de passe.</p>

                {% include 'compte/_flashes.html.twig' %}
                {{ form_errors(form) }}
                {{ form_row(form.email) }}

                <button class='btn-login' type='submit'>Recevoir le lien</button>

                <p class='login-alternative'>
                    <a href='{{ path('app_compte_connexion') }}'>← Retour à la connexion</a>
                </p>
            {{ form_end(form) }}
        </section>
    </div>
{% endblock %}
