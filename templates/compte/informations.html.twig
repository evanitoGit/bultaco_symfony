{% extends 'compte/_layout.html.twig' %}

{% block title %}{{ 'compte.onglet.informations'|trans }} - {{ 'meta.suffixe'|trans }}{% endblock %}

{% block contenu %}
    <div class='compte-bloc'>
        {{ form_start(form, { attr: { class: 'commande-form', novalidate: 'novalidate' } }) }}
            <h2 class='compte-titre'>{{ 'compte.onglet.informations'|trans }}</h2>
            <div class='commande-grille'>
                {{ form_row(form.prenom) }}
                {{ form_row(form.nom) }}
                {{ form_row(form.telephone) }}
            </div>

            <h2 class='compte-titre'>{{ 'commande.adresse_livraison'|trans }}</h2>
            <p class='compte-intro'>{{ 'compte.informations.adresse_aide'|trans }}</p>
            {{ form_row(form.adresse) }}
            <div class='commande-grille commande-grille--3'>
                {{ form_row(form.codePostal) }}
                {{ form_row(form.ville) }}
                {{ form_row(form.pays) }}
            </div>

            <button type='submit' class='btn-commander compte-enregistrer'>{{ 'compte.informations.enregistrer'|trans }}</button>
        {{ form_end(form) }}
    </div>

    <div class='compte-bloc' id='email'>
        {{ form_start(form_email, { action: path('app_compte_informations') ~ '#email', attr: { class: 'commande-form', novalidate: 'novalidate' } }) }}
            <h2 class='compte-titre'>{{ 'form.email'|trans }}</h2>
            <p class='compte-intro'>
                {{ 'compte.informations.adresse_actuelle'|trans }} : <strong>{{ client.email }}</strong>
                {% if client.emailVerifie %}
                    <span class='statut statut--payee'>{{ 'compte.informations.confirmee'|trans }}</span>
                {% else %}
                    <span class='statut statut--en_attente'>{{ 'compte.informations.a_confirmer'|trans }}</span>
                {% endif %}
                <br>{{ 'compte.informations.lien_nouvelle_adresse'|trans }}
            </p>
            {{ form_row(form_email.email) }}
            {{ form_row(form_email.motDePasse) }}
            <button type='submit' class='btn-commander compte-enregistrer'>{{ 'compte.informations.changer_adresse'|trans }}</button>
        {{ form_end(form_email) }}
    </div>
{% endblock %}
{% block footer %} {% endblock %}
