{% extends 'base.html.twig' %}

{# Mise en page commune des pages « Mon compte » : titre, onglets et messages #}
{% block body_class %}page-login page-compte{% endblock %}

{% block body %}
    {% set onglet = app.request.attributes.get('_route') %}

    <div class='head'>
        <h1>Mon compte</h1>
    </div>

    <div class='container'>
        <section class='compte'>
            <nav class='compte-onglets' aria-label='Mon compte'>
                <a href='{{ path('app_compte') }}' class='{{ onglet in ['app_compte', 'app_compte_commande'] ? 'actif' }}'>Mes commandes</a>
                <a href='{{ path('app_compte_informations') }}' class='{{ onglet == 'app_compte_informations' ? 'actif' }}'>Mes informations</a>
                <a href='{{ path('app_compte_mot_de_passe') }}' class='{{ onglet == 'app_compte_mot_de_passe' ? 'actif' }}'>Mot de passe</a>
                <a href='{{ path('app_logout') }}' class='compte-deconnexion'>Se déconnecter</a>
            </nav>

            {% for message in app.flashes('compte') %}
                <p class='panier-message' role='status'>{{ message }}</p>
            {% endfor %}

            {% block contenu %}{% endblock %}
        </section>
    </div>
{% endblock %}
