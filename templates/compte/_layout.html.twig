{% extends 'base.html.twig' %}

{# Mise en page commune des pages « Mon compte » : titre, onglets et messages #}
{% block body_class %}page-login page-compte{% endblock %}

{% block body %}
    {% set onglet = route_courante() %}

    <div class='head'>
        <h1>{{ 'compte.menu.mon_compte'|trans }}</h1>
    </div>

    <div class='container'>
        <section class='compte'>
            <nav class='compte-onglets' aria-label='{{ 'compte.menu.mon_compte'|trans }}'>
                <a href='{{ path('app_compte') }}' class='{{ onglet in ['app_compte', 'app_compte_commande'] ? 'actif' }}'>{{ 'compte.onglet.commandes'|trans }}</a>
                <a href='{{ path('app_compte_demandes') }}' class='{{ onglet == 'app_compte_demandes' ? 'actif' }}'>{{ 'compte.onglet.demandes'|trans }}</a>
                <a href='{{ path('app_compte_garage') }}' class='{{ onglet == 'app_compte_garage' ? 'actif' }}'>{{ 'compte.onglet.garage'|trans }}</a>
                <a href='{{ path('app_compte_informations') }}' class='{{ onglet == 'app_compte_informations' ? 'actif' }}'>{{ 'compte.onglet.informations'|trans }}</a>
                <a href='{{ path('app_compte_mot_de_passe') }}' class='{{ onglet == 'app_compte_mot_de_passe' ? 'actif' }}'>{{ 'compte.onglet.mot_de_passe'|trans }}</a>
                <a href='{{ path('app_compte_donnees') }}' class='{{ onglet == 'app_compte_donnees' ? 'actif' }}'>{{ 'compte.onglet.donnees'|trans }}</a>
                <a href='{{ path('app_logout') }}' class='compte-deconnexion'>{{ 'compte.onglet.deconnexion'|trans }}</a>
            </nav>

            {% include 'compte/_flashes.html.twig' %}

            {% if not app.user.emailVerifie %}
                <div class='compte-verification' role='note'>
                    <p>
                        <strong>{{ 'compte.verification.titre'|trans }}</strong>
                        {{ 'compte.verification.texte'|trans({ email: app.user.email }) }}
                    </p>
                    <form method='post' action='{{ path('app_compte_renvoyer_verification') }}'>
                        <input type='hidden' name='_token' value='{{ csrf_token('renvoyer_verification') }}'>
                        <button type='submit' class='compte-bouton-secondaire'>{{ 'compte.verification.renvoyer'|trans }}</button>
                    </form>
                </div>
            {% endif %}

            {% block contenu %}{% endblock %}
        </section>
    </div>
{% endblock %}
