{% extends 'compte/_layout.html.twig' %}

{% block title %}{{ 'compte.onglet.donnees'|trans }} - {{ 'meta.suffixe'|trans }}{% endblock %}

{% block contenu %}
    <div class='compte-bloc'>
        <h2 class='compte-titre'>{{ 'compte.donnees.telecharger'|trans }}</h2>
        <p class='compte-intro'>
            {{ 'compte.donnees.telecharger_texte'|trans }}
        </p>
        <a href='{{ path('app_compte_export') }}' class='btn-commander compte-enregistrer' download>{{ 'compte.donnees.telecharger'|trans }}</a>
    </div>

    <div class='compte-bloc compte-bloc--danger' id='suppression'>
        {{ form_start(form, { action: path('app_compte_donnees') ~ '#suppression', attr: { class: 'commande-form', novalidate: 'novalidate' } }) }}
            <h2 class='compte-titre'>{{ 'compte.donnees.supprimer'|trans }}</h2>
            <p class='compte-intro'>
                {{ 'compte.donnees.supprimer_texte'|trans }}
            </p>
            {{ form_row(form.motDePasse) }}
            {{ form_row(form.confirmation) }}
            <button type='submit' class='btn-commander compte-enregistrer compte-supprimer'>{{ 'compte.donnees.supprimer_bouton'|trans }}</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
{% block footer %} {% endblock %}
