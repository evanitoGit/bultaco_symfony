{% extends 'base.html.twig' %}

{% block title %}{{ 'compte.reinitialiser.titre'|trans }} - {{ 'meta.suffixe'|trans }}{% endblock %}
{% block body_class %}page-login{% endblock %}

{% block body %}
    <div class='head'>
        <h1>{{ 'compte.menu.mon_compte'|trans }}</h1>
    </div>

    <div class='container'>
        <section class='login-section'>
            {{ form_start(form, { attr: { class: 'login-box commande-form', novalidate: 'novalidate' } }) }}
                <img src="{{ asset('img/logo_rond.png') }}" alt='' class='login-logo'>
                <h2 class='login-title'>{{ 'compte.reinitialiser.titre'|trans }}</h2>
                <p class='login-subtitle'>{{ 'compte.reinitialiser.pour'|trans({ email: '<strong>' ~ email|e ~ '</strong>' })|raw }}</p>

                {{ form_row(form.nouveau) }}

                <button class='btn-login' type='submit'>{{ 'compte.reinitialiser.bouton'|trans }}</button>
            {{ form_end(form) }}
        </section>
    </div>
{% endblock %}
