{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe - Club Bultaco{% endblock %}
{% block body_class %}page-login{% endblock %}

{% block body %}
    <div class='head'>
        <h1>Mon compte</h1>
    </div>

    <div class='container'>
        <section class='login-section'>
            {{ form_start(form, { attr: { class: 'login-box commande-form', novalidate: 'novalidate' } }) }}
                <img src="{{ asset('img/logo_rond.png') }}" alt='' class='login-logo'>
                <h2 class='login-title'>Nouveau mot de passe</h2>
                <p class='login-subtitle'>Pour le compte <strong>{{ email }}</strong></p>

                {{ form_row(form.nouveau) }}

                <button class='btn-login' type='submit'>Enregistrer le mot de passe</button>
            {{ form_end(form) }}
        </section>
    </div>
{% endblock %}
