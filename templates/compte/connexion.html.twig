{% extends 'base.html.twig' %}

{% block title %}{{ 'compte.connexion.titre'|trans }} - {{ 'meta.suffixe'|trans }}{% endblock %}
{% block body_class %}page-login{% endblock %}

{% block body %}
    <div class='head'>
        <h1>{{ 'compte.menu.mon_compte'|trans }}</h1>
    </div>

    <div class='container'>
        <section class='login-section'>
            <form method='post' action='{{ path('app_compte_connexion') }}' class='login-box' novalidate>
                <img src="{{ asset('img/logo_rond.png') }}" alt='' class='login-logo'>
                <h2 class='login-title'>{{ 'compte.connexion.titre'|trans }}</h2>
                <p class='login-subtitle'>{{ 'compte.connexion.sous_titre'|trans }}</p>

                {% include 'compte/_flashes.html.twig' %}

                {% if error %}
                    <div class='login-error' role='alert'>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <label for='inputEmail'>{{ 'form.email'|trans }}</label>
                <input type='text' inputmode='email' value='{{ last_username }}' name='email' id='inputEmail' autocomplete='email' required autofocus>

                <label for='inputPassword'>{{ 'form.mot_de_passe'|trans }}</label>
                <div class='password-field'>
                    <input type='password' name='password' id='inputPassword' autocomplete='current-password' required>
                    <button type='button' class='password-toggle' aria-label='{{ 'compte.connexion.afficher_mdp'|trans }}'
                            onclick="const i = document.getElementById('inputPassword'); i.type = i.type === 'password' ? 'text' : 'password'; this.setAttribute('aria-pressed', i.type === 'text');">👁</button>
                </div>

                <input type='hidden' name='_csrf_token' value='{{ csrf_token('authenticate') }}'>

                <div class='login-options'>
                    <label class='login-remember'>
                        <input type='checkbox' name='_remember_me'> {{ 'compte.connexion.rester_connecte'|trans }}
                    </label>
                    <a href='{{ path('app_compte_mot_de_passe_oublie') }}' class='login-oubli'>{{ 'compte.connexion.oubli'|trans }}</a>
                </div>

                <button class='btn-login' type='submit'>{{ 'compte.menu.se_connecter'|trans }}</button>

                <p class='login-alternative'>
                    {{ 'compte.connexion.pas_de_compte'|trans }}
                    <a href='{{ path('app_compte_inscription', app.request.query.get('retour') == 'commande' ? { retour: 'commande' } : {}) }}'>{{ 'compte.menu.creer_compte'|trans }}</a>
                </p>
                <a href='{{ path('app_home') }}' class='login-back'>{{ icone('fleche-gauche') }} {{ 'commun.retour_site'|trans }}</a>
            </form>
        </section>
    </div>
{% endblock %}
