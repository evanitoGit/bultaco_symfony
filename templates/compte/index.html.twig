{% extends 'compte/_layout.html.twig' %}

{% block title %}{{ 'compte.onglet.commandes'|trans }} - {{ 'meta.suffixe'|trans }}{% endblock %}

{% block contenu %}
    <div class='compte-bloc'>
        <h2 class='compte-titre'>{{ 'compte.menu.bonjour'|trans({ prenom: client.prenom }) }} 👋</h2>
        <p class='compte-intro'>
            {{ 'compte.index.connecte'|trans({ email: '<strong>' ~ client.email|e ~ '</strong>', date: client.dateCreation|date('d/m/Y') })|raw }}
            {% if not client.hasAdresse %}
                <br>{{ 'compte.index.ajouter_adresse'|trans({ lien: '<a href="' ~ path('app_compte_informations') ~ '">', fin: '</a>' })|raw }}
            {% endif %}
            {% if sans_compte > 0 %}
                <br>{{ 'compte.index.sans_compte'|trans({ n: sans_compte }) }}
            {% endif %}
        </p>
    </div>

    <div class='compte-bloc'>
        <h2 class='compte-titre'>{{ 'compte.onglet.commandes'|trans }}</h2>

        {% if commandes is empty %}
            {% include '_partials/_empty.html.twig' with { icone: '🧾', message: 'compte.index.aucune_commande'|trans } %}
            <p class='panier-actions panier-actions--vide'>
                <a href='{{ path('app_boutique_pieces') }}' class='btn-commander'>{{ 'panier.voir_pieces'|trans }}</a>
            </p>
        {% else %}
            <table class='panier-table compte-commandes'>
                <thead>
                    <tr><th>{{ 'compte.index.col.reference'|trans }}</th><th>{{ 'compte.index.col.date'|trans }}</th><th>{{ 'compte.index.col.articles'|trans }}</th><th>{{ 'commun.total'|trans }}</th><th>{{ 'compte.index.col.statut'|trans }}</th><th><span class='sr-only'>{{ 'compte.index.col.detail'|trans }}</span></th></tr>
                </thead>
                <tbody>
                    {% for commande in commandes %}
                        <tr>
                            <td data-label='{{ 'compte.index.col.reference'|trans }}'><strong>{{ commande.reference }}</strong></td>
                            <td data-label='{{ 'compte.index.col.date'|trans }}'>{{ commande.date_commande|date('d/m/Y') }}</td>
                            <td data-label='{{ 'compte.index.col.articles'|trans }}'>{{ commande.nb_articles }}</td>
                            <td data-label='{{ 'commun.total'|trans }}'><strong>{{ commande.total|euros }}</strong></td>
                            <td data-label='{{ 'compte.index.col.statut'|trans }}'><span class='statut statut--{{ commande.statut }}'>{{ ('commande.statut.' ~ commande.statut)|trans }}</span></td>
                            <td class='compte-col-detail'><a href='{{ path('app_compte_commande', { reference: commande.reference }) }}'>{{ 'compte.index.voir_detail'|trans }}</a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
{% block footer %} {% endblock %}
