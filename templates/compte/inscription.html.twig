{% extends 'base.html.twig' %}

{% block title %}{{ 'compte.menu.creer_compte'|trans }} - {{ 'meta.suffixe'|trans }}{% endblock %}
{% block body_class %}page-login{% endblock %}

{% block body %}
    <div class='head'>
        <h1>{{ 'compte.menu.mon_compte'|trans }}</h1>
    </div>

    <div class='container'>
        <section class='login-section'>
            {{ form_start(form, { attr: { class: 'login-box commande-form', novalidate: 'novalidate' } }) }}
                <img src="{{ asset('img/logo_rond.png') }}" alt='' class='login-logo'>
                <h2 class='login-title'>{{ 'compte.menu.creer_compte'|trans }}</h2>
                <p class='login-subtitle'>{{ 'compte.menu.accroche'|trans }}</p>

                <div class='commande-grille'>
                    {{ form_row(form.prenom) }}
                    {{ form_row(form.nom) }}
                </div>
                {{ form_row(form.email) }}
                {{ form_row(form.plainPassword) }}

                <button class='btn-login' type='submit'>{{ 'compte.inscription.bouton'|trans }}</button>

                <p class='login-alternative'>
                    {{ 'compte.inscription.deja_compte'|trans }}
                    <a href='{{ path('app_compte_connexion') }}'>{{ 'compte.menu.se_connecter'|trans }}</a>
                </p>
                <a href='{{ path('app_home') }}' class='login-back'>{{ 'commun.retour_site'|trans }}</a>
            {{ form_end(form) }}
        </section>
    </div>
{% endblock %}
