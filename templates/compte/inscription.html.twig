{% extends 'base.html.twig' %}

{% block title %}Créer un compte - Club Bultaco{% endblock %}
{% block body_class %}page-login{% endblock %}

{% block body %}
    <div class='head'>
        <h1>Mon compte</h1>
    </div>

    <div class='container'>
        <section class='login-section'>
            {{ form_start(form, { attr: { class: 'login-box commande-form', novalidate: 'novalidate' } }) }}
                <img src="{{ asset('img/logo_rond.png') }}" alt='' class='login-logo'>
                <h2 class='login-title'>Créer un compte</h2>
                <p class='login-subtitle'>Suivez vos commandes et commandez plus vite</p>

                <div class='commande-grille'>
                    {{ form_row(form.prenom) }}
                    {{ form_row(form.nom) }}
                </div>
                {{ form_row(form.email) }}
                {{ form_row(form.plainPassword) }}

                <button class='btn-login' type='submit'>Créer mon compte</button>

                <p class='login-alternative'>
                    Déjà un compte ?
                    <a href='{{ path('app_compte_connexion') }}'>Se connecter</a>
                </p>
                <a href='{{ path('app_home') }}' class='login-back'>← Retour au site</a>
            {{ form_end(form) }}
        </section>
    </div>
{% endblock %}
