{% extends 'compte/_layout.html.twig' %}

{% block title %}{{ 'compte.commande.titre'|trans({ reference: commande.reference }) }} - {{ 'meta.suffixe'|trans }}{% endblock %}

{% block contenu %}
    <p><a href='{{ path('app_compte') }}' class='panier-continuer'>{{ icone('fleche-gauche') }} {{ 'compte.commande.toutes'|trans }}</a></p>

    <div class='compte-bloc commande-merci'>
        <div class='compte-entete'>
            <h2 class='compte-titre'>{{ 'compte.commande.titre'|trans({ reference: commande.reference }) }}</h2>
            <span class='statut statut--{{ commande.statut }}'>{{ ('commande.statut.' ~ commande.statut)|trans }}</span>
        </div>
        <p class='compte-intro'>{{ 'compte.commande.passee'|trans({ date: commande.date_commande|date('d/m/Y'), heure: commande.date_commande|date('H:i'), paiement: ('commande.mode.' ~ commande.mode_paiement)|trans }) }}</p>

        <table class='panier-table'>
            <thead><tr><th>{{ 'panier.col.piece'|trans }}</th><th>{{ 'panier.col.quantite'|trans }}</th><th>{{ 'panier.col.sous_total'|trans }}</th></tr></thead>
            <tbody>
                {% for ligne in commande.lignes %}
                    <tr>
                        <td data-label='{{ 'panier.col.piece'|trans }}'><strong>{{ ligne|traduit('nom_piece') }}</strong></td>
                        <td data-label='{{ 'panier.col.quantite'|trans }}'>{{ ligne.quantite }} × {{ ligne.prix_unitaire|euros }}</td>
                        <td data-label='{{ 'panier.col.sous_total'|trans }}'>{{ (ligne.prix_unitaire * ligne.quantite)|euros }}</td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot><tr><th colspan='2'>{{ 'commun.total'|trans }}</th><th>{{ commande.total|euros }}</th></tr></tfoot>
        </table>

        <div class='compte-colonnes'>
            <div>
                <h3>{{ 'compte.commande.livraison'|trans }}</h3>
                <p>{{ commande.prenom }} {{ commande.nom }}<br>{{ commande.adresse }}<br>{{ commande.code_postal }} {{ commande.ville }}<br>{{ commande.pays }}</p>
            </div>
            {% if commande.statut == 'en_attente' %}
                <div>
                    {% include 'commande/_instructions_paiement.html.twig' %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
