{# Partagé par la page de confirmation et l'e-mail au client #}
{% set montant = '<strong>' ~ commande.total|euros ~ '</strong>' %}
{% set reference = '<strong>' ~ commande.reference|e ~ '</strong>' %}
{% if commande.mode_paiement == 'virement' %}
    <h3>{{ 'paiement.virement.titre'|trans }}</h3>
    <p>{{ 'paiement.virement.texte'|trans({ montant: montant, reference: reference })|raw }}</p>
    <p>
        {{ 'paiement.virement.titulaire'|trans }} : Bultaco Club France<br>
        IBAN : FR76 XXXX XXXX XXXX XXXX XXXX XXX<br>
        BIC : XXXXXXXX
    </p>
{% else %}
    <h3>{{ 'paiement.cheque.titre'|trans }}</h3>
    <p>{{ 'paiement.cheque.texte'|trans({ montant: montant, reference: reference, ordre: '<strong>Bultaco Club France</strong>' })|raw }}</p>
    <p>Bultaco Club France<br>4 Chemin du Glais-Malet<br>51220 Merfy<br>{{ 'pied.pays'|trans }}</p>
{% endif %}
<p>{{ 'paiement.expedition'|trans }}</p>
