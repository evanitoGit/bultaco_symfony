{% extends 'base.html.twig' %}

{% block title %}{{ 'commande.titre'|trans }} - {{ 'meta.suffixe'|trans }}{% endblock %}
{% block body_class %}page-pieces{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
    <div class='head'><h1>{{ 'commande.titre'|trans }}</h1></div>

    <div class='container'>
        <section class='commande'>
            {{ form_start(form, { attr: { class: 'commande-form', novalidate: 'novalidate' } }) }}
                <div class='commande-colonnes'>
                    <div class='commande-bloc'>
                        {% if compte %}
                            <p class='commande-compte'>
                                {{ 'commande.connecte'|trans({ email: '<strong>' ~ compte.email|e ~ '</strong>', lien: '<a href="' ~ path('app_compte') ~ '">', fin: '</a>' })|raw }}
                            </p>
                        {% else %}
                            <p class='commande-compte'>
                                {{ 'commande.invite'|trans({
                                    connexion: '<a href="' ~ path('app_compte_connexion', { retour: 'commande' }) ~ '">',
                                    inscription: '<a href="' ~ path('app_compte_inscription', { retour: 'commande' }) ~ '">',
                                    fin: '</a>'
                                })|raw }}
                            </p>
                        {% endif %}

                        <h2 class='commande-titre'>{{ 'commande.coordonnees'|trans }}</h2>
                        <div class='commande-grille'>
                            {{ form_row(form.prenom) }}
                            {{ form_row(form.nom) }}
                            {{ form_row(form.email) }}
                            {{ form_row(form.telephone) }}
                        </div>

                        <h2 class='commande-titre'>{{ 'commande.adresse_livraison'|trans }}</h2>
                        {{ form_row(form.adresse) }}
                        <div class='commande-grille commande-grille--3'>
                            {{ form_row(form.code_postal) }}
                            {{ form_row(form.ville) }}
                            {{ form_row(form.pays) }}
                        </div>

                        <h2 class='commande-titre'>{{ 'commande.paiement'|trans }}</h2>
                        {{ form_row(form.mode_paiement) }}
                        <p class='commande-aide'>{{ 'commande.aide_paiement'|trans }}</p>

                        {{ form_row(form.commentaire) }}
                        {{ form_row(form.accord) }}
                    </div>

                    <aside class='commande-recap'>
                        <h2 class='commande-titre'>{{ 'commande.votre_commande'|trans }}</h2>
                        <ul class='commande-lignes'>
                            {% for ligne in lignes %}
                                <li>
                                    <span>{{ ligne.nom }} <small>× {{ ligne.quantite }}</small></span>
                                    <strong>{{ ligne.sous_total|prix }}</strong>
                                </li>
                            {% endfor %}
                        </ul>
                        <p class='commande-total'><span>{{ 'commun.total'|trans }}</span><strong>{{ total|prix }}</strong></p>
                        <button type='submit' class='btn-commander'>{{ 'commande.valider'|trans }}</button>
                        <a href='{{ path('app_panier') }}' class='panier-continuer'>{{ 'commande.modifier_panier'|trans }}</a>
                    </aside>
                </div>
            {{ form_end(form) }}
        </section>
    </div>
{% endblock %}
