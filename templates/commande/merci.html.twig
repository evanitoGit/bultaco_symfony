{% extends 'base.html.twig' %}

{% block title %}{{ 'commande.merci.titre_page'|trans }} - {{ 'meta.suffixe'|trans }}{% endblock %}
{% block body_class %}page-pieces{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
    <div class='head'><h1>{{ 'commande.merci.titre'|trans }}</h1></div>

    <div class='container'>
        <section class='commande commande-merci'>
            <div class='commande-bloc'>
                <p class='commande-ok'>✓ {{ 'commande.merci.enregistree'|trans({ reference: '<strong>' ~ commande.reference|e ~ '</strong>' })|raw }}</p>
                {% if commande.mode_paiement != 'carte' or commande.date_paiement %}
                <p>{{ 'commande.merci.email_envoye'|trans({ email: '<strong>' ~ commande.email|e ~ '</strong>' })|raw }}</p>
                {% endif %}

                {% include 'commande/_instructions_paiement.html.twig' %}

                <table class='panier-table'>
                    <thead><tr><th>{{ 'panier.col.piece'|trans }}</th><th>{{ 'panier.col.quantite'|trans }}</th><th>{{ 'panier.col.sous_total'|trans }}</th></tr></thead>
                    <tbody>
                        {% for ligne in commande.lignes %}
                            <tr>
                                <td data-label='{{ 'panier.col.piece'|trans }}'><strong>{{ ligne|traduit('nom_piece') }}</strong></td>
                                <td data-label='{{ 'panier.col.quantite'|trans }}'>{{ ligne.quantite }} × {{ ligne.prix_unitaire|euros }}</td>
                                <td data-label='{{ 'panier.col.sous_total'|trans }}'>{{ (ligne.prix_unitaire * ligne.quantite)|euros }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot><tr><th colspan='2'>{{ 'commun.total'|trans }}</th><th>{{ commande.total|euros }}</th></tr></tfoot>
                </table>

                {% if is_granted('ROLE_CLIENT') %}
                    <p class='commande-compte'>{{ 'commande.merci.dans_compte'|trans({ lien: '<a href="' ~ path('app_compte') ~ '">', fin: '</a>' })|raw }}</p>
                {% else %}
                    <div class='commande-invitation'>
                        <p><strong>{{ 'commande.merci.invitation_titre'|trans }}</strong><br>{{ 'commande.merci.invitation_texte'|trans }}</p>
                        <a href='{{ path('app_compte_inscription', { email: commande.email }) }}' class='btn-commander'>{{ 'compte.menu.creer_compte'|trans }}</a>
                    </div>
                {% endif %}

                <p class='panier-actions panier-actions--vide'>
                    <a href='{{ path('app_boutique_pieces') }}' class='btn-commander'>{{ 'commande.merci.retour_boutique'|trans }}</a>
                </p>
            </div>
        </section>
    </div>
{% endblock %}
