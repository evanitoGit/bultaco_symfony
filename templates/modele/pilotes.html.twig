{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.pilotes_legende'|trans }} - {{ 'meta.suffixe'|trans }}{% endblock %}
{% block meta_description %}{{ 'pilotes.meta'|trans }}{% endblock %}

{% block body_class %}page-pilotes{% endblock %}

{% block body %}
    <div class='head'>
        <h1>{{ 'nav.pilotes_legende'|trans }}</h1>
    </div>

    <div class='container'>
        {% include '_partials/_hero.html.twig' with {
            texte: texte_presentation
        } %}

        <section class='emblemes-section'>
            <div class='album-grid'>
                {% for pilote in pilotes %}
                    {% set nom_complet = (pilote.prenom ~ ' ' ~ pilote.nom)|trim %}
                    <article class='album-card pilote-item' data-id='{{ pilote.id }}' role='button' tabindex='0'
                             aria-label='{{ 'pilotes.voir_fiche'|trans({ nom: nom_complet }) }}' onclick='openPiloteModal({{ pilote.id }})'>
                        <div class='album-photo-wrap'>
                            {% if pilote.image_path %}
                                <div class='album-photo' style='background-image: url("{{ asset(pilote.image_path) }}")'></div>
                            {% else %}
                                <div class='album-photo no-photo'>🏆</div>
                            {% endif %}
                        </div>
                        <div class='album-info'>
                            <h3>{{ nom_complet }}</h3>
                            {% if pilote.nationalite %}<p class='album-type'>{{ pilote.nationalite }}</p>{% endif %}
                            {% if pilote.date_naissance or pilote.date_deces %}
                                <p class='album-dates'>{{ pilote.date_naissance ?: '?' }}{% if pilote.date_deces %} – {{ pilote.date_deces }}{% endif %}</p>
                            {% endif %}
                        </div>
                    </article>
                {% else %}
                    {% include '_partials/_empty.html.twig' with { icone: '🏆', message: 'pilotes.aucun'|trans } %}
                {% endfor %}
            </div>
        </section>
    </div>

    {% include '_partials/_modal.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const pilotes = {{ pilotes|json_encode(constant('JSON_HEX_TAG'))|raw }};
        const nomComplet = p => [p.prenom, p.nom].filter(Boolean).join(' ');
        const periode = p => p.date_naissance ? `${p.date_naissance}${p.date_deces ? ' – ' + p.date_deces : ''}` : null;

        function openPiloteModal(id) {
            const pilote = pilotes.find(p => p.id == id);
            if (!pilote) return;

            openModal(`
                <div class='carte-identite'>
                    <div class='carte-header'>
                        <h2>${escapeHtml(nomComplet(pilote))}</h2>
                        <span class='badge-modele'>{{ 'pilotes.badge'|trans }}</span>
                    </div>
                    ${pilote.image_path
                        ? `<img src='${escapeHtml(mediaUrl(pilote.image_path))}' alt='${escapeHtml(nomComplet(pilote))}' class='carte-photo'>`
                        : `<div class='carte-photo-placeholder'>🏆</div>`}
                    <div class='carte-section'>
                        <div class='info-grid'>
                            <div class='info-item'>
                                <span class='info-label'>{{ 'pilotes.naissance'|trans }}</span>
                                <span class='info-value'>${escapeHtml(pilote.date_naissance || {{ 'commun.non_renseigne'|trans|json_encode|raw }})}</span>
                            </div>
                            ${pilote.date_deces ? `
                            <div class='info-item'>
                                <span class='info-label'>{{ 'pilotes.deces'|trans }}</span>
                                <span class='info-value'>${escapeHtml(pilote.date_deces)}</span>
                            </div>` : ''}
                            <div class='info-item'>
                                <span class='info-label'>{{ 'pilotes.nationalite'|trans }}</span>
                                <span class='info-value'>${escapeHtml(pilote.nationalite || {{ 'commun.non_renseigne'|trans|json_encode|raw }})}</span>
                            </div>
                        </div>
                    </div>
                    ${pilote.description ? `<div class='carte-section'><p class='description-text'>${nl2br(pilote.description)}</p></div>` : ''}
                    ${pilote.palmares ? `<div class='carte-section'><h3 class='carte-titre'>🏆 {{ 'pilotes.palmares'|trans }}</h3><div class='caracteristiques-text'>${nl2br(pilote.palmares)}</div></div>` : ''}
                </div>
            `);
        }

        // arrivée depuis la recherche globale (ou un lien partagé) : l'élément s'ouvre
        ouvrirDepuisAncre(/^#pilote-(\d+)$/, openPiloteModal);
    </script>
{% endblock %}
