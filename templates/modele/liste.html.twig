{% extends 'base.html.twig' %}

{% block title %}{{ 'modeles.titre_page'|trans }} - {{ 'meta.suffixe'|trans }}{% endblock %}
{% block meta_description %}{{ 'modeles.meta'|trans }}{% endblock %}

{% block body_class %}page-album{% endblock %}

{% block body %}
    <div class='head'>
        <h1>{{ 'modeles.titre'|trans }}</h1>
    </div>

    <div class='container'>
        {% include '_partials/_hero.html.twig' with {
            texte: texte_presentation
        } %}

        <section class='emblemes-section'>
            <div class='album-grid'>
                {% for modele in modeles %}
                    <article class='album-card modele-item' data-id='{{ modele.id }}' role='button' tabindex='0'
                             aria-label='{{ 'modeles.voir_fiche'|trans({ nom: modele.nom }) }}' onclick='openModeleModal({{ modele.id }})'>
                        <div class='album-photo-wrap'>
                            {% if modele.image_path %}
                                <div class='album-photo' style='background-image: url("{{ asset(modele.image_path) }}")'></div>
                            {% else %}
                                <div class='album-photo no-photo'>🏍️</div>
                            {% endif %}
                        </div>
                        <div class='album-info'>
                            <h3>{{ modele.nom }}</h3>
                            {% if modele.type_moto %}<p class='album-type'>{{ modele.type_moto }}</p>{% endif %}
                            {% if modele.annee_debut or modele.annee_fin %}
                                <p class='album-dates'>{{ modele.annee_debut ?: '?' }} – {{ modele.annee_fin ?: '?' }}</p>
                            {% endif %}
                        </div>
                    </article>
                {% else %}
                    {% include '_partials/_empty.html.twig' with { icone: '🏍️', message: 'modeles.aucun'|trans } %}
                {% endfor %}
            </div>
        </section>
    </div>

    {% include '_partials/_modal.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const modeles = {{ modeles|json_encode(constant('JSON_HEX_TAG'))|raw }};

        function openModeleModal(id) {
            const modele = modeles.find(m => m.id == id);
            if (!modele) return;

            openModal(`
                <div class='carte-identite'>
                    <div class='carte-header'>
                        <h2>${escapeHtml(modele.nom)}</h2>
                        <span class='badge-modele'>{{ 'modeles.badge'|trans|e('html') }}</span>
                    </div>
                    ${modele.image_path
                        ? `<img src='${escapeHtml(mediaUrl(modele.image_path))}' alt='${escapeHtml(modele.nom)}' class='carte-photo'>`
                        : `<div class='carte-photo-placeholder'>🏍️</div>`}
                    <div class='carte-section'>
                        <div class='info-grid'>
                            <div class='info-item'>
                                <span class='info-label'>{{ 'modeles.periode'|trans }}</span>
                                <span class='info-value'>${escapeHtml(modele.annee_debut || '?')} – ${escapeHtml(modele.annee_fin || '?')}</span>
                            </div>
                            <div class='info-item'>
                                <span class='info-label'>{{ 'modeles.cylindree'|trans }}</span>
                                <span class='info-value'>${escapeHtml(modele.cylindree || {{ 'commun.non_renseigne'|trans|json_encode|raw }})}</span>
                            </div>
                            <div class='info-item'>
                                <span class='info-label'>{{ 'modeles.type'|trans }}</span>
                                <span class='info-value'>${escapeHtml(modele.type_moto || {{ 'commun.non_renseigne'|trans|json_encode|raw }})}</span>
                            </div>
                        </div>
                    </div>
                    ${modele.description ? `<div class='carte-section'><p class='description-text'>${nl2br(modele.description)}</p></div>` : ''}
                    ${modele.caracteristiques ? `<div class='carte-section'><h3 class='carte-titre'>{{ 'modeles.caracteristiques'|trans }}</h3><div class='caracteristiques-text'>${nl2br(modele.caracteristiques)}</div></div>` : ''}
                    ${modele.page ? `<div class='carte-section carte-pieces'><a href='${escapeHtml(modele.page)}' class='btn-commander'>{{ 'modele_page.voir_page'|trans|e('js') }}</a></div>` : ''}
                    ${modele.motos.length ? `<div class='carte-section carte-pieces'>${modele.motos.map(moto =>
                        `<a href='${escapeHtml(moto.url)}' class='btn-commander'>⚙️ ${escapeHtml(modele.motos.length > 1 ? {{ 'modeles.pieces_pour'|trans({ moto: '__MOTO__' })|json_encode|raw }}.replace('__MOTO__', moto.nom) : {{ 'modeles.voir_pieces'|trans|json_encode|raw }})}</a>`).join('')}</div>` : ''}
                </div>
            `);
        }

        // arrivée depuis la recherche globale (ou un lien partagé) : l'élément s'ouvre
        ouvrirDepuisAncre(/^#modele-(\d+)$/, openModeleModal);
    </script>
{% endblock %}
