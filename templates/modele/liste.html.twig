{% extends 'base.html.twig' %}

{% block title %}Liste des modèles - Club Bultaco{% endblock %}

{% block body_class %}page-album{% endblock %}

{% block body %}
    <div class='head'>
        <h1>Album Photos</h1>
    </div>

    <div class='container'>
        <section class='hero'>
            <p>{{ texte_presentation }}</p>
            {% include '_partials/_search.html.twig' with { placeholder: 'Rechercher un modèle...' } %}
        </section>

        <section class='emblemes-section'>
            <div class='album-grid'>
                {% for modele in modeles %}
                    <div class='album-card modele-item' data-id='{{ modele.id }}' onclick='openModeleModal({{ modele.id }})'>
                        {% if modele.image_path %}
                            <div class='album-photo' style='background-image: url("{{ modele.image_path }}")'></div>
                        {% else %}
                            <div class='album-photo no-photo'>🏍️</div>
                        {% endif %}
                        <div class='album-info'>
                            <h3>{{ modele.nom }}</h3>
                            <p class='album-type'>{{ modele.type_moto ?? '' }}</p>
                            {% if modele.annee_debut or modele.annee_fin %}
                                <p class='album-dates'>{{ modele.annee_debut ?: '?' }} - {{ modele.annee_fin ?: '?' }}</p>
                            {% endif %}
                        </div>
                    </div>
                {% else %}
                    <p class='no-items'>Aucun modèle pour le moment</p>
                {% endfor %}
            </div>
        </section>
    </div>

    {% include '_partials/_modal.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const modeles = {{ modeles|json_encode|raw }};

        window.searchConfig = {
            data       : modeles,
            fields     : ['nom', 'type_moto', 'description'],
            labelField : 'nom',
            metaFields : ['type_moto'],
            emptyText  : 'Aucun modèle trouvé',
            onSelect   : item => openModeleModal(item.id)
        };

        function openModeleModal(id) {
            const modele = modeles.find(m => m.id == id);
            if (!modele) return;

            openModal(`
                <div class='carte-identite'>
                    <div class='carte-header'>
                        <h2>${escapeHtml(modele.nom)}</h2>
                        <span class='badge-modele'>MODÈLE</span>
                    </div>
                    ${modele.image_path
                        ? `<img src='${escapeHtml(modele.image_path)}' alt='${escapeHtml(modele.nom)}' class='carte-photo'>`
                        : `<div class='carte-photo-placeholder'>🏍️</div>`}
                    <div class='carte-section'>
                        <div class='info-grid'>
                            <div class='info-item'>
                                <span class='info-label'>Période :</span>
                                <span class='info-value'>${escapeHtml(modele.annee_debut || '?')} - ${escapeHtml(modele.annee_fin || '?')}</span>
                            </div>
                            <div class='info-item'>
                                <span class='info-label'>Cylindrée :</span>
                                <span class='info-value'>${escapeHtml(modele.cylindree || 'N/A')}</span>
                            </div>
                            <div class='info-item'>
                                <span class='info-label'>Type :</span>
                                <span class='info-value'>${escapeHtml(modele.type_moto || 'N/A')}</span>
                            </div>
                        </div>
                    </div>
                    ${modele.description ? `<div class='carte-section'><p class='description-text'>${nl2br(modele.description)}</p></div>` : ''}
                    ${modele.caracteristiques ? `<div class='carte-section'><div class='caracteristiques-text'>${nl2br(modele.caracteristiques)}</div></div>` : ''}
                </div>
            `);
        }
    </script>
    <script src="{{ asset('js/search.js') }}"></script>
{% endblock %}
