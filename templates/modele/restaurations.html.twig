{% extends 'base.html.twig' %}

{% block title %}{{ 'restaurations.titre'|trans }} - {{ 'meta.suffixe'|trans }}{% endblock %}
{% block meta_description %}{{ 'restaurations.meta'|trans }}{% endblock %}

{% block body_class %}page-restau{% endblock %}

{% block body %}
    <div class='head'>
        <h1>{{ 'restaurations.titre'|trans }}</h1>
    </div>

    <div class='container'>
        {% include '_partials/_hero.html.twig' with {
            texte: texte_presentation,
            sous_titre: 'restaurations.sous_titre'|trans
        } %}

        <section class='restau-section'>
            {% if restaurations is empty %}
                {% include '_partials/_empty.html.twig' with { icone: '🔧', message: 'restaurations.aucune'|trans } %}
            {% else %}
                <div class='restau-liste'>
                    {% for restauration in restaurations %}
                        <figure class='restau-carte' data-id='{{ restauration.id }}'>
                            <div class='restau-visuel'>
                                {% if restauration.photo_avant and restauration.photo_apres %}
                                    {% include '_partials/_comparateur.html.twig' with {
                                        avant: asset(restauration.photo_avant),
                                        apres: asset(restauration.photo_apres),
                                        titre: restauration.titre
                                    } %}
                                {% else %}
                                    {# une seule photo pour l'instant #}
                                    <img class='restau-photo-seule' src='{{ asset(restauration.photo_avant ?: restauration.photo_apres) }}' alt='{{ restauration.titre }}' loading='lazy'>
                                {% endif %}
                                <button type='button' class='restau-agrandir zoom-hint' onclick='ouvrirRestauration({{ restauration.id }})'
                                        aria-label='{{ 'restaurations.agrandir'|trans({ nom: restauration.titre }) }}' title='{{ 'restaurations.agrandir'|trans({ nom: restauration.titre }) }}'>{{ icone('agrandir') }}</button>
                            </div>
                            <figcaption class='restau-legende'>
                                <h3>{{ restauration.titre }}</h3>
                            </figcaption>
                        </figure>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const restaurations = {{ restaurations|map(r => {
            id: r.id,
            titre: r.titre,
            avant: r.photo_avant ? asset(r.photo_avant) : null,
            apres: r.photo_apres ? asset(r.photo_apres) : null
        })|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }};

        // En grand : comparateur pour chaque restauration, flèches pour passer à la suivante
        function ouvrirRestauration(id) {
            ouvrirGalerie(
                restaurations.map(r => (r.avant && r.apres
                    ? { avant: r.avant, apres: r.apres, legende: r.titre }
                    : { src: r.avant || r.apres, legende: r.titre })),
                restaurations.findIndex(r => r.id == id)
            );
        }

        // arrivée depuis la recherche globale (ou un lien partagé) : l'élément s'ouvre
        ouvrirDepuisAncre(/^#restauration-(\d+)$/, id => scrollAndHighlight(document.querySelector(`.restau-carte[data-id='${id}']`)));
    </script>
{% endblock %}
