{% extends 'base.html.twig' %}

{% block title %}Restaurations - Club Bultaco{% endblock %}

{% block body_class %}page-restau{% endblock %}

{% block body %}
    <div class='head'>
        <h1>Restaurations</h1>
    </div>

    <div class='container'>
        <section class='hero'>
            <p>{{ texte_presentation }}</p>
            <h2>QUELQUES EXEMPLES</h2>
            {% include '_partials/_search.html.twig' with { placeholder: 'Rechercher un modèle...' } %}
        </section>

        <section class='restau-section'>
            {% if photos is empty %}
                <p class='no-items'>Aucune restauration pour le moment</p>
            {% else %}
                <div class='restau-grid'>
                    {% for colonne in colonnes %}
                        <div class='colonne'>
                            {% for photo in colonne %}
                                <div class='album-card restau-item' data-id='{{ photo.id }}' onclick='openPhotoModal({{ photo.id }})'>
                                    <img class='restau-photo' src='{{ photo.image_path }}' alt='{{ photo.nom_modele }}' loading='lazy'>
                                    <div class='album-info'>
                                        <h3>{{ photo.nom_modele }}</h3>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </div>

    {% include '_partials/_modal.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const photos = {{ photos|json_encode|raw }};

        window.searchConfig = {
            data       : photos,
            fields     : ['nom_modele'],
            labelField : 'nom_modele',
            emptyText  : 'Aucun modèle trouvé',
            onSelect   : item => scrollAndHighlight(document.querySelector(`.restau-item[data-id='${item.id}']`))
        };

        function openPhotoModal(id) {
            const photo = photos.find(p => p.id == id);
            if (!photo) return;

            openModal(`
                <div class='carte-identite'>
                    <div class='carte-header'>
                        <h2>${escapeHtml(photo.nom_modele)}</h2>
                        <span class='badge-modele'>RESTAURATION</span>
                    </div>
                    <img src='${escapeHtml(photo.image_path)}' alt='${escapeHtml(photo.nom_modele)}' class='carte-photo'>
                </div>
            `);
        }
    </script>
    <script src="{{ asset('js/search.js') }}"></script>
{% endblock %}
