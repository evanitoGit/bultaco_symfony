{% extends 'base.html.twig' %}

{% block title %}Restaurations - Club Bultaco{% endblock %}
{% block meta_description %}Exemples de restaurations de motos Bultaco réalisées par le club.{% endblock %}

{% block body_class %}page-restau{% endblock %}

{% block body %}
    <div class='head'>
        <h1>Restaurations</h1>
    </div>

    <div class='container'>
        {% include '_partials/_hero.html.twig' with {
            texte: texte_presentation,
            sous_titre: 'Quelques exemples',
            placeholder: 'Rechercher un modèle...'
        } %}

        <section class='restau-section'>
            {% if photos is empty %}
                {% include '_partials/_empty.html.twig' with { icone: '🔧', message: 'Aucune restauration pour le moment' } %}
            {% else %}
                <div class='restau-grid'>
                    {% for colonne in colonnes %}
                        <div class='colonne'>
                            {% for photo in colonne %}
                                <figure class='album-card restau-item' data-id='{{ photo.id }}' role='button' tabindex='0'
                                        aria-label='Agrandir la photo {{ photo.nom_modele }}' onclick='openPhotoModal({{ photo.id }})'>
                                    <div class='album-photo-wrap'>
                                        <img class='restau-photo' src='{{ asset(photo.image_path) }}' alt='{{ photo.nom_modele }}' loading='lazy'>
                                        <span class='zoom-hint' aria-hidden='true'>⤢</span>
                                    </div>
                                    <figcaption class='album-info'>
                                        <h3>{{ photo.nom_modele }}</h3>
                                    </figcaption>
                                </figure>
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </div>

    {% include '_partials/_modal.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const photos = {{ photos|json_encode(constant('JSON_HEX_TAG'))|raw }};

        window.searchConfig = {
            data       : photos,
            fields     : ['nom_modele'],
            labelField : 'nom_modele',
            emptyText  : 'Aucun modèle trouvé',
            onSelect   : item => scrollAndHighlight(document.querySelector(`.restau-item[data-id='${item.id}']`))
        };

        function openPhotoModal(id) {
            const photo = photos.find(p => p.id == id);
            if (!photo) return;

            openModal(`
                <div class='carte-identite'>
                    <div class='carte-header'>
                        <h2>${escapeHtml(photo.nom_modele)}</h2>
                        <span class='badge-modele'>Restauration</span>
                    </div>
                    <img src='${escapeHtml(mediaUrl(photo.image_path))}' alt='${escapeHtml(photo.nom_modele)}' class='carte-photo carte-photo--large'>
                </div>
            `);
        }
    </script>
    <script src="{{ asset('js/search.js') }}"></script>
{% endblock %}
