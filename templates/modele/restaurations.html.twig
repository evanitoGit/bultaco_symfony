{% extends 'base.html.twig' %}

{% block title %}{{ 'restaurations.titre'|trans }} - {{ 'meta.suffixe'|trans }}{% endblock %}
{% block meta_description %}{{ 'restaurations.meta'|trans }}{% endblock %}

{% block body_class %}page-restau{% endblock %}

{% block body %}
    <div class='head'>
        <h1>{{ 'restaurations.titre'|trans }}</h1>
    </div>

    <div class='container'>
        {% include '_partials/_hero.html.twig' with {
            texte: texte_presentation,
            sous_titre: 'restaurations.sous_titre'|trans,
            placeholder: 'modeles.recherche'|trans
        } %}

        <section class='restau-section'>
            {% if photos is empty %}
                {% include '_partials/_empty.html.twig' with { icone: '🔧', message: 'restaurations.aucune'|trans } %}
            {% else %}
                <div class='restau-grid'>
                    {% for colonne in colonnes %}
                        <div class='colonne'>
                            {% for photo in colonne %}
                                <figure class='album-card restau-item' data-id='{{ photo.id }}' role='button' tabindex='0'
                                        aria-label='{{ 'restaurations.agrandir'|trans({ nom: photo.nom_modele }) }}' onclick='ouvrirPhoto({{ photo.id }})'>
                                    <div class='album-photo-wrap'>
                                        <img class='restau-photo' src='{{ asset(photo.image_path) }}' alt='{{ photo.nom_modele }}' loading='lazy'>
                                        <span class='zoom-hint' aria-hidden='true'>{{ icone('agrandir') }}</span>
                                    </div>
                                    <figcaption class='album-info'>
                                        <h3>{{ photo.nom_modele }}</h3>
                                    </figcaption>
                                </figure>
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const photos = {{ photos|json_encode(constant('JSON_HEX_TAG'))|raw }};

        window.searchConfig = {
            data       : photos,
            fields     : ['nom_modele'],
            labelField : 'nom_modele',
            emptyText  : {{ 'modeles.aucun_trouve'|trans|json_encode|raw }},
            onSelect   : item => scrollAndHighlight(document.querySelector(`.restau-item[data-id='${item.id}']`))
        };

        // Galerie : toutes les photos, dans l'ordre « avant » puis « après » de chaque restauration
        const photosGalerie = [...photos]
            .sort((a, b) => (a.ordre - b.ordre) || ((a.colonne === 'droite') - (b.colonne === 'droite')) || (a.id - b.id))
            .map(p => ({ id: p.id, src: mediaUrl(p.image_path), legende: p.nom_modele }));

        function ouvrirPhoto(id) {
            ouvrirGalerie(photosGalerie, photosGalerie.findIndex(p => p.id == id));
        }
    </script>
    <script src="{{ asset('js/search.js') }}"></script>
{% endblock %}
