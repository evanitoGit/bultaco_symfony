{% extends 'base.html.twig' %}

{% set rupture = piece.stock is not null and piece.stock <= 0 %}
{% set url_absolue = absolute_url(piece.url) %}
{% set resume = (piece.description ?: piece.description_longue ?: 'piece.meta_defaut'|trans({ nom: piece.nom }))|striptags|replace({ "\n": ' ', "\r": '' }) %}
{% set resume = resume|length > 160 ? resume|slice(0, 157) ~ '…' : resume %}

{% block title %}{{ piece.nom }} - {{ 'nav.pieces_detachees'|trans }} - {{ 'meta.suffixe'|trans }}{% endblock %}
{% block meta_description %}{{ resume }}{% endblock %}
{% block body_class %}page-pieces page-piece{% endblock %}

{% block meta %}
    <link rel="canonical" href="{{ url_absolue }}">
    {# Aperçu lors d'un partage (Facebook, messageries…) #}
    <meta property="og:type" content="product">
    <meta property="og:site_name" content="Bultaco Club France">
    <meta property="og:title" content="{{ piece.nom }}">
    <meta property="og:description" content="{{ resume }}">
    <meta property="og:url" content="{{ url_absolue }}">
    <meta property="og:locale" content="{{ { fr: 'fr_FR', en: 'en_GB', es: 'es_ES' }[app.request.locale] ?? 'fr_FR' }}">
    {% if piece.photos is not empty %}
        <meta property="og:image" content="{{ absolute_url(asset(piece.photos|first)) }}">
    {% endif %}
    {% if prix_visibles() %}
        <meta property="product:price:amount" content="{{ piece.prix }}">
        <meta property="product:price:currency" content="EUR">
    {% endif %}
    {# Données « Produit » pour les moteurs de recherche (prix et disponibilité dans les résultats) #}
    {% set produit = {
            '@context': 'https://schema.org',
            '@type': 'Product',
            name: piece.nom,
            description: resume,
            sku: piece.reference_origine ?: 'BCF-' ~ piece.id,
            category: piece.categorie ~ ' > ' ~ piece.sous_categorie,
            image: piece.photos|map(photo => absolute_url(asset(photo)))
    } %}
    {% if vente_ouverte() %}
        {% set produit = produit|merge({ offers: {
                '@type': 'Offer',
                url: url_absolue,
                priceCurrency: 'EUR',
                price: piece.prix,
                availability: rupture ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock'
        } }) %}
    {% endif %}
    <script type="application/ld+json">
        {{ produit|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG'))|raw }}
    </script>
{% endblock %}

{% block body %}
    <div class='head'>
        <p class='head-titre'>{{ 'nav.pieces_detachees'|trans }}</p>
    </div>

    <div class='container'>
        <section class='piece-page'>
            <nav class='fil-ariane' aria-label='{{ 'piece.fil_ariane'|trans }}'>
                <a href='{{ path('app_boutique_pieces') }}'>{{ 'nav.boutique'|trans }}</a>
                {{ icone('chevron-droite', 'separateur') }}
                <a href='{{ path('app_boutique_pieces') }}#cat-{{ piece.categorie_id }}'>{{ piece.categorie }}</a>
                {{ icone('chevron-droite', 'separateur') }}
                <span>{{ piece.sous_categorie }}</span>
            </nav>

            {% for message in app.flashes('panier') %}
                <p class='panier-message' role='status'>{{ message }}</p>
            {% endfor %}

            {% include '_partials/_vitrine.html.twig' %}

            <div class='piece-fiche'>
                {# ----- Photos ----- #}
                <div class='piece-galerie'>
                    {% if piece.photos is not empty %}
                        <button type='button' class='piece-photo-principale' aria-label='{{ 'piece.agrandir'|trans }}'>
                            <img src='{{ asset(piece.photos|first) }}' alt='{{ piece.nom }}' id='photoPrincipale'>
                            <span class='zoom-hint' aria-hidden='true'>{{ icone('agrandir') }}</span>
                        </button>
                        {% if piece.photos|length > 1 %}
                            <ul class='piece-vignettes'>
                                {% for photo in piece.photos %}
                                    <li>
                                        <button type='button' class='piece-vignette{{ loop.first ? ' active' }}' data-src='{{ asset(photo) }}'
                                                aria-label='{{ 'piece.photo_n'|trans({ n: loop.index, total: piece.photos|length }) }}'{% if loop.first %} aria-current='true'{% endif %}>
                                            <img src='{{ asset(photo) }}' alt='' loading='lazy'>
                                        </button>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    {% else %}
                        <div class='piece-photo-principale piece-photo-principale--vide' aria-hidden='true'>📦</div>
                    {% endif %}
                </div>

                {# ----- Achat ----- #}
                <div class='piece-details'>
                    <h1 class='piece-titre'>{{ piece.nom }}</h1>
                    {% if piece.reference_origine %}
                        <p class='piece-reference'>{{ 'piece.reference'|trans }} : <strong>{{ piece.reference_origine }}</strong></p>
                    {% endif %}
                    {% if piece.description %}
                        <p class='piece-resume'>{{ piece.description }}</p>
                    {% endif %}

                    {% if prix_visibles() %}
                        <p class='piece-page-prix'>{{ piece.prix|euros }}</p>
                    {% endif %}
                    {% if not vente_ouverte() %}
                        {# boutique en mode vitrine : pas de stock ni de panier, contact du club #}
                        <a href='{{ path('app_demande_piece', { piece: piece.id }) }}' class='btn-commander piece-achat'>{{ 'vitrine.contacter'|trans }}</a>
                    {% elseif rupture %}
                        <p class='piece-stock piece-stock--rupture'>{{ 'boutique.rupture'|trans }}</p>
                    {% elseif piece.stock is not null and piece.stock <= constant('App\\Cart\\Cart::STOCK_FAIBLE') %}
                        <p class='piece-stock piece-stock--faible'>{{ 'boutique.plus_que'|trans({ n: piece.stock }) }}</p>
                    {% else %}
                        <p class='piece-stock piece-stock--ok'>✓ {{ 'piece.en_stock'|trans }}</p>
                    {% endif %}

                    {% if not vente_ouverte() %}
                        {# mode vitrine : ni alerte de stock ni panier #}
                    {% elseif rupture %}
                        {# « Prévenez-moi quand elle revient » #}
                        <div class='piece-alerte' id='alerte'>
                            {% for message in app.flashes('alerte') %}
                                <p class='panier-message{{ message[0] == 'erreur' ? ' compte-alerte' }}' role='status'>{{ message[1] }}</p>
                            {% endfor %}
                            {% if alerte_en_attente %}
                                <p class='piece-alerte-ok'>{{ 'alerte.deja_inscrit'|trans({ email: app.user.email }) }}</p>
                            {% else %}
                                <p class='piece-alerte-titre'>{{ 'alerte.titre'|trans }}</p>
                                <p class='piece-alerte-texte'>{{ 'alerte.texte'|trans }}</p>
                                <form method='post' action='{{ path('app_alerte_stock', { id: piece.id }) }}' class='piece-alerte-form'>
                                    <input type='hidden' name='_token' value='{{ csrf_token('alerte_stock') }}'>
                                    {% if is_granted('ROLE_CLIENT') %}
                                        <button type='submit' class='btn-commander'>{{ 'alerte.bouton_connecte'|trans({ email: app.user.email }) }}</button>
                                    {% else %}
                                        <label for='alerteEmail' class='sr-only'>{{ 'form.email'|trans }}</label>
                                        <input type='email' name='email' id='alerteEmail' required autocomplete='email' placeholder='{{ 'alerte.placeholder'|trans }}'>
                                        <button type='submit' class='btn-commander'>{{ 'alerte.bouton'|trans }}</button>
                                    {% endif %}
                                </form>
                            {% endif %}
                        </div>
                    {% else %}
                        <form method='post' action='{{ path('app_panier_ajouter', { id: piece.id }) }}' class='form-panier piece-achat'>
                            <input type='hidden' name='_token' value='{{ csrf_token('panier') }}'>
                            <label class='piece-quantite'>
                                <span>{{ 'panier.col.quantite'|trans }}</span>
                                <input type='number' name='quantite' value='1' min='1' max='{{ piece.stock is null ? 99 : min(99, piece.stock) }}'>
                            </label>
                            <button type='submit' class='btn-commander'>{{ 'boutique.ajouter'|trans }}</button>
                        </form>
                    {% endif %}

                    {# ----- Compatibilité ----- #}
                    <div class='piece-compatibilite'>
                        <h2>{{ 'piece.compatibilite'|trans }}</h2>
                        {% if piece.universelle %}
                            <p>✓ {{ 'piece.universelle_texte'|trans }}</p>
                        {% elseif piece.modeles is not empty %}
                            {% if moto and moto.id not in piece.modeles|column('id') %}
                                <p class='piece-compat-alerte'>⚠ {{ 'piece.pas_indiquee'|trans({ moto: moto.nom }) }}</p>
                            {% endif %}
                            <ul class='piece-modeles'>
                                {% for modele in piece.modeles %}
                                    <li><a href='{{ path('app_boutique_pieces', { moto: modele.id }) }}'
                                           class='{{ moto and moto.id == modele.id ? 'actif' }}'
                                           title='{{ 'piece.voir_pieces_modele'|trans({ moto: modele.nom }) }}'>{{ modele.nom }}</a></li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p class='piece-compat-inconnue'>{{ 'piece.compat_inconnue'|trans }}</p>
                        {% endif %}
                    </div>

                    {# ----- Partage ----- #}
                    <div class='piece-partage'>
                        <span>{{ 'piece.partager'|trans }}</span>
                        <button type='button' class='piece-partage-bouton' data-copier='{{ url_absolue }}' data-copie='{{ 'piece.lien_copie'|trans }}'>{{ icone('copier') }}{{ icone('coche') }} {{ 'piece.copier_lien'|trans }}</button>
                        <a class='piece-partage-bouton' href='https://www.facebook.com/sharer/sharer.php?u={{ url_absolue|url_encode }}' target='_blank' rel='noopener'>Facebook</a>
                        <a class='piece-partage-bouton' href='mailto:?subject={{ piece.nom|url_encode }}&amp;body={{ ('piece.email_corps'|trans({ nom: piece.nom }) ~ ' ' ~ url_absolue)|url_encode }}'>✉ {{ 'piece.email'|trans }}</a>
                    </div>
                </div>
            </div>

            {% if piece.description_longue %}
                <div class='piece-bloc'>
                    <h2>{{ 'piece.description'|trans }}</h2>
                    <p class='piece-description-longue'>{{ piece.description_longue|nl2br }}</p>
                </div>
            {% endif %}

            {# Pièces précédente / suivante du même rayon (sous-catégorie) #}
            {% if voisines.precedente or voisines.suivante %}
                <nav class='piece-voisines' aria-label='{{ 'piece.voisines'|trans({ rayon: piece.sous_categorie }) }}'>
                    {% for sens, voisine in { precedente: voisines.precedente, suivante: voisines.suivante } %}
                        {% if voisine %}
                            <a href='{{ voisine.url }}' class='piece-voisine piece-voisine--{{ sens }}' rel='{{ sens == 'precedente' ? 'prev' : 'next' }}'>
                                {{ icone(sens == 'precedente' ? 'chevron-gauche' : 'chevron-droite') }}
                                {% if voisine.image_path %}
                                    <img src='{{ asset(voisine.image_path) }}' alt='' loading='lazy'>
                                {% endif %}
                                <span>
                                    <small>{{ ('piece.' ~ sens)|trans }}</small>
                                    <strong>{{ voisine.nom }}</strong>
                                </span>
                            </a>
                        {% else %}
                            <span aria-hidden='true'></span>
                        {% endif %}
                    {% endfor %}
                </nav>
            {% endif %}

            {% if similaires is not empty %}
                <div class='piece-bloc'>
                    <h2>{{ 'piece.similaires'|trans }}</h2>
                    <ul class='piece-similaires'>
                        {% for autre in similaires %}
                            {% include '_partials/_piece_mini.html.twig' with { piece: autre } only %}
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {% include '_partials/_vues_recentes.html.twig' with { piece_courante: piece.id } %}

            <p><a href='{{ path('app_boutique_pieces') }}' class='panier-continuer'>{{ icone('fleche-gauche') }} {{ 'piece.retour'|trans }}</a></p>
        </section>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Galerie : la vignette choisie devient la photo principale
        const photoPrincipale = document.getElementById('photoPrincipale');
        document.querySelectorAll('.piece-vignette').forEach(vignette => {
            vignette.addEventListener('click', () => {
                photoPrincipale.src = vignette.dataset.src;
                document.querySelectorAll('.piece-vignette').forEach(v => {
                    v.classList.toggle('active', v === vignette);
                    v.toggleAttribute('aria-current', v === vignette);
                });
            });
        });

        // Zoom : galerie plein écran, ouverte sur la photo affichée
        const photosPiece = {{ piece.photos|map(photo => asset(photo))|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }};
        document.querySelector('button.piece-photo-principale')?.addEventListener('click', () => {
            const affichee = photosPiece.indexOf(photoPrincipale.getAttribute('src'));
            ouvrirGalerie(photosPiece.map(src => ({ src, legende: photoPrincipale.alt })), Math.max(0, affichee));
        });
    </script>
{% endblock %}
