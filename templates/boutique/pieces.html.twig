{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.pieces_detachees'|trans }} - {{ 'meta.suffixe'|trans }}{% endblock %}
{% block meta_description %}{{ 'boutique.meta'|trans }}{% endblock %}

{% block body_class %}page-pieces{% endblock %}

{% block body %}
    <div class='head'>
        <h1>{{ 'nav.pieces_detachees'|trans }}</h1>
    </div>

    <div class='container'>
        {% include '_partials/_hero.html.twig' with {
            texte: texte_presentation,
            sous_titre: 'boutique.catalogue'|trans,
            placeholder: 'boutique.recherche'|trans
        } %}

        {% for message in app.flashes('panier') %}
            <p class='panier-message' role='status'>{{ message }}</p>
        {% endfor %}

        {% include '_partials/_vitrine.html.twig' %}

        {# Filtre « Ma moto » : ne garder que les pièces compatibles #}
        {% if modeles_moto is not empty %}
            <form method='get' action='{{ path('app_boutique_pieces') }}' class='filtre-moto'>
                <label for='filtreMoto'>{{ 'boutique.ma_moto'|trans }}</label>
                <select name='moto' id='filtreMoto' onchange='this.form.submit()'>
                    <option value='0'>{{ 'boutique.toutes_motos'|trans }}</option>
                    {% for modele in modeles_moto %}
                        <option value='{{ modele.id }}'{{ moto and moto.id == modele.id ? ' selected' }}>{{ modele.nom }}{{ modele.cylindree ? ' — ' ~ modele.cylindree }}</option>
                    {% endfor %}
                </select>
                <noscript><button type='submit' class='btn-commander'>{{ 'boutique.filtrer'|trans }}</button></noscript>
            </form>
            {% if moto %}
                <p class='filtre-moto-actif' role='status'>
                    {{ 'boutique.filtre_actif'|trans({ moto: '<strong>' ~ moto.nom|e ~ '</strong>', n: pieces|length })|raw }}
                    <a href='{{ path('app_boutique_pieces', { moto: 0 }) }}'>{{ 'boutique.voir_toutes'|trans }}</a>
                </p>
            {% endif %}
        {% endif %}

        <section class='pieces-section'>
            <div class='categories-container'>
                {% for categorie in categories %}
                    <div class='categorie-block'>
                        <div class='categorie-header' role='button' tabindex='0' aria-expanded='{{ moto ? 'true' : 'false' }}' aria-controls='cat-{{ categorie.id }}'
                             onclick="toggleBloc('cat-{{ categorie.id }}')">
                            <h3>
                                <span class='arrow' aria-hidden='true'>{{ icone('chevron-droite') }}</span>
                                {{ categorie.nom }}
                                <span class='badge'>{{ 'boutique.nb_pieces'|trans({ n: categorie.nb_pieces }) }}</span>
                            </h3>
                        </div>

                        <div class='categorie-content' id='cat-{{ categorie.id }}'{{ moto ? '' : ' hidden' }}>
                            {% for sousCategorie in categorie.sous_categories %}
                                <div class='sous-categorie-block'>
                                    <div class='sous-categorie-header' role='button' tabindex='0' aria-expanded='{{ moto ? 'true' : 'false' }}' aria-controls='sous-cat-{{ sousCategorie.id }}'
                                         onclick="toggleBloc('sous-cat-{{ sousCategorie.id }}')">
                                        <h4>
                                            <span class='arrow' aria-hidden='true'>{{ icone('chevron-droite') }}</span>
                                            {{ sousCategorie.nom }}
                                            <span class='badge-small'>{{ sousCategorie.pieces|length }}</span>
                                        </h4>
                                    </div>

                                    <div class='sous-categorie-content' id='sous-cat-{{ sousCategorie.id }}'{{ moto ? '' : ' hidden' }}>
                                        <div class='pieces-grid'>
                                            {% for piece in sousCategorie.pieces %}
                                                {% set rupture = piece.stock is not null and piece.stock <= 0 %}
                                                <article class='piece-card{{ rupture and vente_ouverte() ? ' piece-card--rupture' }}' data-id='{{ piece.id }}'>
                                                    <a href='{{ piece.url }}' class='piece-media' tabindex='-1' aria-hidden='true'>
                                                        {% if piece.image_path %}
                                                            <img src='{{ asset(piece.image_path) }}' alt='' loading='lazy'>
                                                        {% else %}
                                                            <div class='no-image'></div>
                                                        {% endif %}
                                                    </a>
                                                    <div class='piece-info'>
                                                        <h5><a href='{{ piece.url }}' class='piece-lien'>{{ piece.nom }}</a></h5>
                                                        {% if piece.universelle %}
                                                            <span class='piece-compat piece-compat--universelle'>{{ 'boutique.universelle'|trans }}</span>
                                                        {% elseif moto and piece.compatible %}
                                                            <span class='piece-compat'>✓ {{ 'boutique.compatible'|trans({ moto: moto.nom }) }}</span>
                                                        {% endif %}
                                                        {% if piece.description %}
                                                            <p class='piece-description'>{{ piece.description }}</p>
                                                        {% endif %}
                                                        {% if vente_ouverte() %}
                                                            {% if rupture %}
                                                                <p class='piece-stock piece-stock--rupture'>{{ 'boutique.rupture'|trans }}</p>
                                                            {% elseif piece.stock is not null and piece.stock <= constant('App\\Cart\\Cart::STOCK_FAIBLE') %}
                                                                <p class='piece-stock piece-stock--faible'>{{ 'boutique.plus_que'|trans({ n: piece.stock }) }}</p>
                                                            {% endif %}
                                                        {% endif %}
                                                        <div class='piece-footer'>
                                                            {% if prix_visibles() %}
                                                                <span class='piece-prix'>{{ piece.prix|euros }}</span>
                                                            {% endif %}
                                                            {% if vente_ouverte() %}
                                                                <form method='post' action='{{ path('app_panier_ajouter', { id: piece.id }) }}' class='form-panier'>
                                                                    <input type='hidden' name='_token' value='{{ csrf_token('panier') }}'>
                                                                    {% if rupture %}
                                                                        <a href='{{ piece.url }}#alerte' class='btn-commander btn-alerte'>{{ 'alerte.me_prevenir'|trans }}</a>
                                                                    {% else %}
                                                                        <button type='submit' class='btn-commander'>{{ 'boutique.ajouter'|trans }}</button>
                                                                    {% endif %}
                                                                </form>
                                                            {% else %}
                                                                <a href='{{ path('app_demande_piece', { piece: piece.id }) }}' class='btn-commander'>{{ 'vitrine.contacter'|trans }}</a>
                                                            {% endif %}
                                                        </div>
                                                    </div>
                                                </article>
                                            {% else %}
                                                <p class='no-pieces'>{{ 'boutique.aucune_piece_sous_categorie'|trans }}</p>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            {% else %}
                                <p class='no-pieces'>{{ 'boutique.aucune_piece_categorie'|trans }}</p>
                            {% endfor %}
                        </div>
                    </div>
                {% else %}
                    {% include '_partials/_empty.html.twig' with { icone: '📦', message: moto ? 'boutique.aucune_compatible'|trans({ moto: moto.nom }) : 'boutique.aucune_piece'|trans } %}
                    {% if moto %}
                        <p class='panier-actions panier-actions--vide'><a href='{{ path('app_boutique_pieces', { moto: 0 }) }}' class='btn-commander'>{{ 'boutique.voir_toutes'|trans }}</a></p>
                    {% endif %}
                {% endfor %}
            </div>

            {# « Vous ne trouvez pas votre pièce ? » : demande envoyée au club #}
            <aside class='demande-encart'>
                <p><strong>{{ 'demande.encart.titre'|trans }}</strong> {{ 'demande.encart.texte'|trans }}</p>
                <a href='{{ path('app_demande_piece', moto ? { moto: moto.id } : {}) }}' class='btn-commander'>{{ 'demande.encart.bouton'|trans }}</a>
            </aside>
        </section>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const pieces = {{ pieces|json_encode(constant('JSON_HEX_TAG'))|raw }};
        const formatPrix = prix => parseFloat(prix || 0).toLocaleString(window.I18N.locale, { style: 'currency', currency: 'EUR' });

        function setBloc(id, ouvert) {
            const content = document.getElementById(id);
            const header = document.querySelector(`[aria-controls='${id}']`);
            if (!content) return;
            content.hidden = !ouvert;
            if (header) header.setAttribute('aria-expanded', ouvert);
        }

        // arrivée depuis le fil d'Ariane d'une pièce (#cat-3) : catégorie ouverte
        if (/^#cat-\d+$/.test(location.hash)) setBloc(location.hash.slice(1), true);

        function toggleBloc(id) {
            const content = document.getElementById(id);
            if (content) setBloc(id, content.hidden);
        }

        window.searchConfig = {
            data       : pieces,
            fields     : ['description', 'categorie', 'sous_categorie', 'reference_origine'],
            labelField : 'nom',
            metaFields : p => [`${p.categorie} / ${p.sous_categorie}`{% if prix_visibles() %}, formatPrix(p.prix){% endif %}],
            emptyText  : {{ 'boutique.aucune_trouvee'|trans|json_encode|raw }},
            emptyLink  : { texte: {{ 'demande.encart.bouton'|trans|json_encode|raw }}, url: {{ path('app_demande_piece')|json_encode|raw }} },
            // résultat choisi : ouverture de la page de la pièce
            onSelect   : item => { window.location.href = item.url; }
        };
    </script>
    <script src="{{ asset('js/search.js') }}"></script>
{% endblock %}
