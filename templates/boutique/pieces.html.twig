{% extends 'base.html.twig' %}

{% set email_commande = 'bultaco.club.france@gmail.com' %}

{% block title %}Pièces détachées - Club Bultaco{% endblock %}
{% block meta_description %}Catalogue de pièces détachées pour motos Bultaco : moteur, cadre, électricité...{% endblock %}

{% block body_class %}page-pieces{% endblock %}

{% block body %}
    <div class='head'>
        <h1>Pièces détachées</h1>
    </div>

    <div class='container'>
        {% include '_partials/_hero.html.twig' with {
            texte: texte_presentation,
            sous_titre: 'Catalogue des pièces',
            placeholder: 'Rechercher une pièce...'
        } %}

        <section class='pieces-section'>
            <div class='categories-container'>
                {% for categorie in categories %}
                    <div class='categorie-block'>
                        <div class='categorie-header' role='button' tabindex='0' aria-expanded='false' aria-controls='cat-{{ categorie.id }}'
                             onclick="toggleBloc('cat-{{ categorie.id }}')">
                            <h3>
                                <span class='arrow' aria-hidden='true'>▶</span>
                                {{ categorie.nom }}
                                <span class='badge'>{{ categorie.nb_pieces }} pièce{{ categorie.nb_pieces > 1 ? 's' }}</span>
                            </h3>
                        </div>

                        <div class='categorie-content' id='cat-{{ categorie.id }}' hidden>
                            {% for sousCategorie in categorie.sous_categories %}
                                <div class='sous-categorie-block'>
                                    <div class='sous-categorie-header' role='button' tabindex='0' aria-expanded='false' aria-controls='sous-cat-{{ sousCategorie.id }}'
                                         onclick="toggleBloc('sous-cat-{{ sousCategorie.id }}')">
                                        <h4>
                                            <span class='arrow' aria-hidden='true'>▶</span>
                                            {{ sousCategorie.nom }}
                                            <span class='badge-small'>{{ sousCategorie.pieces|length }}</span>
                                        </h4>
                                    </div>

                                    <div class='sous-categorie-content' id='sous-cat-{{ sousCategorie.id }}' hidden>
                                        <div class='pieces-grid'>
                                            {% for piece in sousCategorie.pieces %}
                                                <article class='piece-card' data-id='{{ piece.id }}'>
                                                    <div class='piece-media'>
                                                        {% if piece.image_path %}
                                                            <img src='{{ piece.image_path }}' alt='{{ piece.nom }}' loading='lazy'>
                                                        {% else %}
                                                            <div class='no-image' aria-hidden='true'>📦</div>
                                                        {% endif %}
                                                    </div>
                                                    <div class='piece-info'>
                                                        <h5>{{ piece.nom }}</h5>
                                                        {% if piece.description %}
                                                            <p class='piece-description'>{{ piece.description }}</p>
                                                        {% endif %}
                                                        <div class='piece-footer'>
                                                            <span class='piece-prix'>{{ piece.prix|number_format(2, ',', ' ') }} €</span>
                                                            <a class='btn-commander'
                                                               href='mailto:{{ email_commande }}?subject={{ ('Commande : ' ~ piece.nom)|url_encode }}&body={{ ("Bonjour,\n\nJe souhaite commander la pièce suivante :\n- " ~ piece.nom ~ ' (' ~ piece.prix|number_format(2, ',', ' ') ~ " €)\n\nMerci.")|url_encode }}'>
                                                                Commander
                                                            </a>
                                                        </div>
                                                    </div>
                                                </article>
                                            {% else %}
                                                <p class='no-pieces'>Aucune pièce disponible pour le moment</p>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            {% else %}
                                <p class='no-pieces'>Aucune pièce dans cette catégorie pour le moment</p>
                            {% endfor %}
                        </div>
                    </div>
                {% else %}
                    {% include '_partials/_empty.html.twig' with { icone: '📦', message: 'Aucune pièce pour le moment' } %}
                {% endfor %}
            </div>
        </section>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const pieces = {{ pieces|json_encode(constant('JSON_HEX_TAG'))|raw }};
        const formatPrix = prix => parseFloat(prix || 0).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';

        function setBloc(id, ouvert) {
            const content = document.getElementById(id);
            const header = document.querySelector(`[aria-controls='${id}']`);
            if (!content) return;
            content.hidden = !ouvert;
            if (header) header.setAttribute('aria-expanded', ouvert);
        }

        function toggleBloc(id) {
            const content = document.getElementById(id);
            if (content) setBloc(id, content.hidden);
        }

        window.searchConfig = {
            data       : pieces,
            fields     : ['description', 'categorie', 'sous_categorie'],
            labelField : 'nom',
            metaFields : p => [`${p.categorie} › ${p.sous_categorie}`, formatPrix(p.prix)],
            emptyText  : 'Aucune pièce trouvée',
            onSelect   : function (item) {
                const card = document.querySelector(`.piece-card[data-id='${item.id}']`);
                if (!card) return;
                // Ouverture de la catégorie et de la sous-catégorie contenant la pièce
                setBloc(card.closest('.categorie-content').id, true);
                setBloc(card.closest('.sous-categorie-content').id, true);
                setTimeout(() => scrollAndHighlight(card), 100);
            }
        };
    </script>
    <script src="{{ asset('js/search.js') }}"></script>
{% endblock %}
