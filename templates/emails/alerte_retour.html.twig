<div style="font-family: Arial, sans-serif; color: #474747; max-width: 600px; margin: 0 auto;">
    {% include 'emails/_entete.html.twig' %}
    <div style="padding: 24px;">
        <h1 style="font-size: 22px;">{{ 'email.alerte.retour_titre'|trans }}</h1>
        <p>{{ 'email.alerte.retour_texte'|trans({ nom: '<strong>' ~ piece.nom|e ~ '</strong>' })|raw }}</p>
        {% include 'emails/_piece_carte.html.twig' %}
        <p>{{ 'email.alerte.retour_vite'|trans }}</p>
        <p style="font-size: 13px; color: #8a7a6a;">{{ 'email.alerte.retour_unique'|trans }}</p>
        <p>{{ 'email.a_bientot'|trans }}<br>Le Bultaco Club France</p>
    </div>
</div>
