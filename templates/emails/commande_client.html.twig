<div style="font-family: Arial, sans-serif; color: #474747; max-width: 600px; margin: 0 auto;">
    {% include 'emails/_entete.html.twig' %}
    <div style="padding: 24px;">
        <h1 style="font-size: 22px;">{{ 'email.commande.titre'|trans }}</h1>
        <p>{{ 'email.bonjour'|trans({ prenom: commande.prenom }) }}</p>
        <p>{{ 'email.commande.recue'|trans({ reference: '<strong>' ~ commande.reference|e ~ '</strong>', date: commande.date_commande|date('d/m/Y') })|raw }}</p>

        {% include 'emails/_recap_commande.html.twig' %}
        {% include 'commande/_instructions_paiement.html.twig' %}

        <p><strong>{{ 'compte.commande.livraison'|trans }} :</strong><br>
            {{ commande.prenom }} {{ commande.nom }}<br>
            {{ commande.adresse }}<br>
            {{ commande.code_postal }} {{ commande.ville }} — {{ commande.pays }}
        </p>
        <p>{{ 'email.commande.question'|trans }}</p>
        <p>{{ 'email.a_bientot'|trans }}<br>Le Bultaco Club France</p>
    </div>
</div>
