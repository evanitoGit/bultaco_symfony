<div style="font-family: Arial, sans-serif; color: #474747; max-width: 600px; margin: 0 auto;">
    {% include 'emails/_entete.html.twig' %}
    <div style="padding: 24px;">
        <h1 style="font-size: 22px;">{{ 'email.verification.titre'|trans }}</h1>
        <p>{{ 'email.bonjour'|trans({ prenom: client.prenom }) }}</p>
        <p>{{ 'email.verification.texte'|trans({ email: '<strong>' ~ client.email|e ~ '</strong>' })|raw }}</p>
        <p style="text-align: center; margin: 28px 0;">
            <a href="{{ url }}" style="display: inline-block; padding: 12px 28px; border-radius: 50px; background: #474747; color: #fff2e3; font-weight: bold; text-decoration: none;">{{ 'email.verification.bouton'|trans }}</a>
        </p>
        <p>{{ 'email.verification.commandes'|trans }}</p>
        <p style="font-size: 13px; color: #8a7a6a;">{{ 'email.verification.validite'|trans }}<br>
            {{ 'email.lien_direct'|trans }} : <a href="{{ url }}" style="color: #8a7a6a; word-break: break-all;">{{ url }}</a></p>
        <p>{{ 'email.a_bientot'|trans }}<br>Le Bultaco Club France</p>
    </div>
</div>
