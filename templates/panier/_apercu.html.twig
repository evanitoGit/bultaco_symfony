{% if lignes is empty %}
    <p class='mini-panier-vide'>{{ 'panier.vide_point'|trans }}</p>
    <a href='{{ path('app_boutique_pieces') }}' class='mini-panier-lien'>{{ 'panier.voir_pieces'|trans }}</a>
{% else %}
    <ul class='mini-panier-lignes'>
        {% for ligne in lignes|slice(0, 4) %}
            <li>
                {% if ligne.image_path %}
                    <img src='{{ asset(ligne.image_path) }}' alt='' onerror="this.replaceWith(Object.assign(document.createElement('span'), { className: 'mini-panier-img', textContent: '📦' }))">
                {% else %}
                    <span class='mini-panier-img' aria-hidden='true'>📦</span>
                {% endif %}
                <span class='mini-panier-nom'>
                    {{ ligne.nom }}
                    <small>{{ ligne.quantite }} × {{ ligne.prix_unitaire|prix }}</small>
                </span>
                <strong>{{ ligne.sous_total|prix }}</strong>
            </li>
        {% endfor %}
    </ul>

    {% if lignes|length > 4 %}
        <p class='mini-panier-plus'>{{ 'panier.autres_articles'|trans({ n: lignes|length - 4 }) }}</p>
    {% endif %}

    <p class='mini-panier-total'><span>{{ 'commun.total'|trans }}</span><strong>{{ total|prix }}</strong></p>
    <a href='{{ path('app_panier') }}' class='mini-panier-lien'>{{ 'panier.voir_mon_panier'|trans }}</a>
{% endif %}
