<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{% block meta_description %}Club Bultaco France : modèles, restaurations, pilotes de légende, documentation et pièces détachées.{% endblock %}">
    <title>{% block title %}Club Bultaco - Escuyer{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ asset('img/logo_rond.png') }}" sizes="50x50">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body class="{% block body_class %}page-default{% endblock %}" data-base-path="{{ app.request.basePath }}">
<header class='nav'>
    <button type='button' class='nav-toggle' aria-label='Ouvrir le menu' aria-expanded='false' aria-controls='mainNav'>
        <span></span><span></span><span></span>
    </button>
    <nav class='header-nav' id='mainNav'>
        <ul>
            <li>
                <a href="{{ path('app_home') }}">
                    <img src="{{ asset('img/logo_bultaco.png') }}" alt='Bultaco - Accueil'>
                </a>
            </li>

            {% set current_route = app.request.attributes.get('_route') %}
            {% set menu = {
                'Modèles': { 'Liste': 'app_modeles_liste', 'Restaurations': 'app_modeles_restaurations', 'Pilotes': 'app_modeles_pilotes' },
                'Documentation': { 'Logos': 'app_doc_logos', 'Pressbook': 'app_doc_pressbook' },
                'Boutique': { 'Pièces détachées': 'app_boutique_pieces' }
            } %}
            {% for categorie, liens in menu %}
                <li class="categorie{{ current_route in liens ? ' active' }}">
                    <span class="main-link" tabindex="0" aria-haspopup="true">
                        {{ categorie }}
                        <svg class="chevron" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <div class="sous-menu">
                        <ul>
                            {% for label, route in liens %}
                                <li><a href="{{ path(route) }}"{% if current_route == route %} class="active" aria-current="page"{% endif %}>{{ label }}</a></li>
                            {% endfor %}
                        </ul>
                    </div>
                </li>
            {% endfor %}

            {% set client_connecte = is_granted('ROLE_CLIENT') %}
            <li class='compte-lien'>
                {# Sans JavaScript, le bouton reste un lien vers l'espace client #}
                <a href='{{ path(client_connecte ? 'app_compte' : 'app_compte_connexion') }}' class='compte-bouton{{ client_connecte ? ' connecte' }}'
                   role='button' aria-haspopup='menu' aria-expanded='false' aria-controls='menuCompte'
                   aria-label='{{ client_connecte ? 'Mon compte (' ~ app.user.prenom ~ ')' : 'Mon compte' }}'
                   title='Mon compte'>
                    <svg width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'
                         stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
                        <circle cx='12' cy='8' r='4'/><path d='M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8'/>
                    </svg>
                </a>

                <div class='mini-panier menu-compte' id='menuCompte'>
                    <div class='mini-panier-contenu'>
                        {% if client_connecte %}
                            <p class='menu-compte-entete'>
                                <span>Bonjour <strong>{{ app.user.prenom }}</strong></span>
                                <small class='menu-compte-email'>{{ app.user.email }}</small>
                            </p>
                            <ul class='menu-compte-liens' role='menu'>
                                <li role='none'><a role='menuitem' href='{{ path('app_compte') }}'>Mes commandes</a></li>
                                <li role='none'><a role='menuitem' href='{{ path('app_compte_informations') }}'>Mes informations</a></li>
                                <li role='none'><a role='menuitem' href='{{ path('app_compte_mot_de_passe') }}'>Mot de passe</a></li>
                                <li role='none'><a role='menuitem' href='{{ path('app_compte_donnees') }}'>Mes données</a></li>
                                <li role='none' class='menu-compte-separation'><a role='menuitem' href='{{ path('app_logout') }}' class='menu-compte-deconnexion'><span aria-hidden='true'>↪</span>Se déconnecter</a></li>
                            </ul>
                        {% else %}
                            <p class='menu-compte-entete'>
                                <strong>Mon compte</strong>
                                <small>Suivez vos commandes et commandez plus vite</small>
                            </p>
                            <a href='{{ path('app_compte_connexion') }}' class='mini-panier-lien'>Se connecter</a>
                            <ul class='menu-compte-liens' role='menu'>
                                <li role='none'><a role='menuitem' href='{{ path('app_compte_inscription') }}'>Créer un compte</a></li>
                                <li role='none'><a role='menuitem' href='{{ path('app_compte_mot_de_passe_oublie') }}'>>Mot de passe oublié</a></li>
                            </ul>
                        {% endif %}
                    </div>
                </div>
            </li>

            <li class='panier-lien'>
                <button type='button' class='panier-bouton' aria-label='Mon panier' aria-expanded='false'
                        aria-controls='miniPanier' data-apercu-url='{{ path('app_panier_apercu') }}'>
                    <svg width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'
                         stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
                        <circle cx='9' cy='20' r='1.5'/><circle cx='18' cy='20' r='1.5'/>
                        <path d='M2 3h3l2.6 12.4a1 1 0 0 0 1 .8h9.7a1 1 0 0 0 1-.8L21 7H6'/>
                    </svg>
                    <span class='panier-badge' data-panier-nombre {{ panier_nombre() == 0 ? 'hidden' }}>{{ panier_nombre() }}</span>
                </button>

                <div class='mini-panier' id='miniPanier' role='dialog' aria-label='Récapitulatif du panier'>
                    <div class='mini-panier-contenu' data-mini-panier>Chargement…</div>
                </div>
            </li>
        </ul>
    </nav>
</header>

{% block body %}{% endblock %}

{% block footer %}
<footer class='coordonnees'>
    <div class='coord-header'>
        <h2>BULTACO CLUB FRANCE</h2>
        <div class='separator'></div>
    </div>

    <div class='coord-content'>
        <div class='coord-bloc adresse'>
            <h3>ADRESSE</h3>
            <p>4 Chemin du Glais-Malet</p>
            <p>51220 Merfy</p>
            <p>France</p>
        </div>

        <div class='coord-bloc contact'>
            <h3>CONTACT</h3>
            <p><a href='tel:+33675068320'>06 75 06 83 20</a></p>
            <p><a href='mailto:bultaco.club.france@gmail.com'>bultaco.club.france@gmail.com</a></p>
        </div>

        <div class='coord-bloc reseaux-bloc'>
            <h3>RÉSEAUX SOCIAUX</h3>
            <div class='reseaux-links'>
                <a href="https://www.instagram.com/bultaco_club_france/" class='reseau-item' target='_blank' rel='noopener'>
                    <img src="{{ asset('img/sociale.png') }}" alt='Instagram'>
                    <span>@bultaco_club_france</span>
                </a>
                <a href="https://www.facebook.com/share/g/1Ak8gYsypU/" class='reseau-item' target='_blank' rel='noopener'>
                    <img src="{{ asset('img/facebook.png') }}" alt='Facebook'>
                    <span>Groupe Bultaco Club France</span>
                </a>
            </div>
        </div>
    </div>

    <div class='coord-footer'>
        <p>Passion Bultaco depuis 1958</p>
    </div>
    <a href="{{ path('app_login') }}" class='logorond-link' aria-label='Espace administrateur'>
        <img src="{{ asset('img/logo_rond.png') }}" alt='' class='logorond'>
    </a>
</footer>
{% endblock %}

{% if is_granted('ROLE_ADMIN') %}
    <a href="{{ path('app_admin') }}" class='admin-shortcut'>⚙ Administration</a>
{% endif %}

<script src="{{ asset('js/script.js') }}"></script>
<script src="{{ asset('js/panier.js') }}"></script>
<script src="{{ asset('js/compte.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
