<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{% block meta_description %}{{ 'meta.description'|trans }}{% endblock %}">
    <title>{% block title %}Club Bultaco - Escuyer{% endblock %}</title>
    {# Même page dans les autres langues (moteurs de recherche) #}
    {% for code, nom in langues() %}
        <link rel="alternate" hreflang="{{ code }}" href="{{ absolute_url(url_langue(code)) }}">
    {% endfor %}
    <link rel="icon" type="image/png" href="{{ asset('img/logo_rond.png') }}" sizes="50x50">
    {# Balises propres à une page (partage sur les réseaux sociaux, données pour Google…) #}
    {% block meta %}{% endblock %}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body class="{% block body_class %}page-default{% endblock %}" data-base-path="{{ app.request.basePath }}">
<header class='nav'>
    <button type='button' class='nav-toggle' aria-label='{{ 'nav.ouvrir_menu'|trans }}' aria-expanded='false' aria-controls='mainNav'>
        <span></span><span></span><span></span>
    </button>
    <nav class='header-nav' id='mainNav'>
        <ul>
            <li>
                <a href="{{ path('app_home') }}">
                    <img src="{{ asset('img/logo_bultaco.png') }}" alt='{{ 'nav.logo_accueil'|trans }}'>
                </a>
            </li>

            {% set current_route = route_courante() %}
            {# clés de traduction : catégorie => { lien => route } #}
            {% set menu = {
                'nav.modeles': { 'nav.liste': 'app_modeles_liste', 'nav.restaurations': 'app_modeles_restaurations', 'nav.pilotes': 'app_modeles_pilotes' },
                'nav.documentation': { 'nav.logos': 'app_doc_logos', 'nav.pressbook': 'app_doc_pressbook' },
                'nav.boutique': { 'nav.pieces_detachees': 'app_boutique_pieces' }
            } %}
            {% for categorie, liens in menu %}
                <li class="categorie{{ current_route in liens ? ' active' }}">
                    <span class="main-link" tabindex="0" aria-haspopup="true">
                        {{ categorie|trans }}
                        <svg class="chevron" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <div class="sous-menu">
                        <ul>
                            {% for label, route in liens %}
                                <li><a href="{{ path(route) }}"{% if current_route == route %} class="active" aria-current="page"{% endif %}>{{ label|trans }}</a></li>
                            {% endfor %}
                        </ul>
                    </div>
                </li>
            {% endfor %}

            {#
                Recherche sur tout le site : la loupe déploie un champ dans l'en-tête, les résultats
                s'affichent dessous pendant la frappe (script.js). Entrée ou la loupe : page /recherche.
                Sans JavaScript, la loupe mène directement à la page /recherche.
            #}
            <li class='recherche-lien' data-recherche data-url='{{ path('app_recherche_suggestions') }}'>
                <form method='get' action='{{ path('app_recherche') }}' class='recherche-entete' role='search'>
                    <label for='rechercheEntete' class='sr-only'>{{ 'recherche.ouvrir'|trans }}</label>
                    <input type='search' name='q' id='rechercheEntete' class='recherche-entete-champ' placeholder='{{ 'recherche.placeholder'|trans }}'
                           autocomplete='off' enterkeyhint='search' tabindex='-1' aria-controls='rechercheResultats' aria-expanded='false'>
                    <button type='button' class='recherche-entete-fermer' data-recherche-fermer aria-label='{{ 'commun.fermer'|trans }}'>&times;</button>
                    <button type='submit' class='recherche-bouton' data-recherche-bouton aria-label='{{ 'recherche.ouvrir'|trans }}'
                            title='{{ 'recherche.ouvrir'|trans }} (Ctrl+K)'>{{ icone('loupe') }}</button>
                </form>
                <div class='recherche-panneau' id='rechercheResultats' hidden>
                    <div class='recherche-resultats' data-recherche-resultats>
                        <p class='recherche-aide'>{{ 'recherche.aide'|trans }}</p>
                    </div>
                    <p class='recherche-astuce'>{{ 'recherche.astuce'|trans }}</p>
                </div>
            </li>

            {# Ma sélection : visible dès qu'une pièce a été ajoutée avec le cœur (script.js) #}
            <li class='selection-lien' data-selection-lien hidden>
                <a href='{{ path('app_boutique_selection') }}' class='selection-bouton' aria-label='{{ 'selection.titre'|trans }}' title='{{ 'selection.titre'|trans }}'>
                    {{ icone('coeur') }}
                    <span class='panier-badge' data-selection-nombre></span>
                </a>
            </li>

            {% set client_connecte = is_granted('ROLE_CLIENT') %}
            <li class='compte-lien'>
                {# Sans JavaScript, le bouton reste un lien vers l'espace client #}
                <a href='{{ path(client_connecte ? 'app_compte' : 'app_compte_connexion') }}' class='compte-bouton{{ client_connecte ? ' connecte' }}'
                   role='button' aria-haspopup='menu' aria-expanded='false' aria-controls='menuCompte'
                   aria-label='{{ client_connecte ? 'compte.menu.mon_compte_de'|trans({ prenom: app.user.prenom }) : 'compte.menu.mon_compte'|trans }}'
                   title='{{ 'compte.menu.mon_compte'|trans }}'>
                    <svg width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'
                         stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
                        <circle cx='12' cy='8' r='4'/><path d='M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8'/>
                    </svg>
                </a>

                <div class='mini-panier menu-compte' id='menuCompte'>
                    <div class='mini-panier-contenu'>
                        {% if client_connecte %}
                            <p class='menu-compte-entete'>
                                <span>{{ 'compte.menu.bonjour'|trans({ prenom: '<strong>' ~ app.user.prenom|e ~ '</strong>' })|raw }}</span>
                                <small class='menu-compte-email'>{{ app.user.email }}</small>
                            </p>
                            <ul class='menu-compte-liens' role='menu'>
                                <li role='none'><a role='menuitem' href='{{ path('app_compte') }}'>{{ 'compte.onglet.commandes'|trans }}</a></li>
                                <li role='none'><a role='menuitem' href='{{ path('app_boutique_selection') }}'>{{ 'selection.titre'|trans }}</a></li>
                                <li role='none'><a role='menuitem' href='{{ path('app_compte_demandes') }}'>{{ 'compte.onglet.demandes'|trans }}</a></li>
                                <li role='none'><a role='menuitem' href='{{ path('app_compte_garage') }}'>{{ 'compte.onglet.garage'|trans }}</a></li>
                                <li role='none'><a role='menuitem' href='{{ path('app_compte_informations') }}'>{{ 'compte.onglet.informations'|trans }}</a></li>
                                <li role='none'><a role='menuitem' href='{{ path('app_compte_mot_de_passe') }}'>{{ 'compte.onglet.mot_de_passe'|trans }}</a></li>
                                <li role='none'><a role='menuitem' href='{{ path('app_compte_donnees') }}'>{{ 'compte.onglet.donnees'|trans }}</a></li>
                                <li role='none' class='menu-compte-separation'><a role='menuitem' href='{{ path('app_logout') }}' class='menu-compte-deconnexion'>{{ icone('deconnexion') }}{{ 'compte.onglet.deconnexion'|trans }}</a></li>
                            </ul>
                        {% else %}
                            <p class='menu-compte-entete'>
                                <strong>{{ 'compte.menu.mon_compte'|trans }}</strong>
                                <small>{{ 'compte.menu.accroche'|trans }}</small>
                            </p>
                            <a href='{{ path('app_compte_connexion') }}' class='mini-panier-lien'>{{ 'compte.menu.se_connecter'|trans }}</a>
                            <ul class='menu-compte-liens' role='menu'>
                                <li role='none'><a role='menuitem' href='{{ path('app_compte_inscription') }}'>{{ 'compte.menu.creer_compte'|trans }}</a></li>
                                <li role='none'><a role='menuitem' href='{{ path('app_boutique_selection') }}'>{{ 'selection.titre'|trans }}</a></li>
                                <li role='none'><a role='menuitem' href='{{ path('app_compte_mot_de_passe_oublie') }}'>{{ 'compte.menu.mot_de_passe_oublie'|trans }}</a></li>
                            </ul>
                        {% endif %}
                    </div>
                </div>
            </li>

            {% if vente_ouverte() %}
                <li class='panier-lien'>
                    <button type='button' class='panier-bouton' aria-label='{{ 'panier.mon_panier'|trans }}' aria-expanded='false'
                            aria-controls='miniPanier' data-apercu-url='{{ path('app_panier_apercu') }}'>
                        <svg width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'
                             stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
                            <circle cx='9' cy='20' r='1.5'/><circle cx='18' cy='20' r='1.5'/>
                            <path d='M2 3h3l2.6 12.4a1 1 0 0 0 1 .8h9.7a1 1 0 0 0 1-.8L21 7H6'/>
                        </svg>
                        <span class='panier-badge' data-panier-nombre {{ panier_nombre() == 0 ? 'hidden' }}>{{ panier_nombre() }}</span>
                    </button>

                    <div class='mini-panier' id='miniPanier' role='dialog' aria-label='{{ 'panier.recapitulatif'|trans }}'>
                        <div class='mini-panier-contenu' data-mini-panier>{{ 'commun.chargement'|trans }}</div>
                    </div>
                </li>
            {% endif %}

            {# Langues : drapeaux empilés à droite du panier (dans le menu ☰ sur mobile) #}
            <li class='langues'>
                <ul class='langues-liste' aria-label='{{ 'nav.langue'|trans }}'>
                    {% for code, nom in langues() %}
                        <li>
                            <a href='{{ url_langue(code) }}' hreflang='{{ code }}' lang='{{ code }}' title='{{ nom }}'
                               class='langue{{ code == app.request.locale ? ' active' }}'{% if code == app.request.locale %} aria-current='true'{% endif %}>
                                <img src='{{ asset('img/drapeaux/' ~ code ~ '.svg') }}' alt='{{ nom }}' width='24' height='16'>
                                <span class='langue-nom'>{{ nom }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </li>
        </ul>
    </nav>
</header>

{% block body %}{% endblock %}

{% block footer %}
<footer class='coordonnees'>
    <div class='coord-header'>
        <h2>BULTACO CLUB FRANCE</h2>
        <div class='separator'></div>
    </div>

    <div class='coord-content'>
        <div class='coord-bloc adresse'>
            <h3>{{ 'pied.adresse'|trans }}</h3>
            {# Sans JavaScript (ou Ctrl+clic) : Google Maps dans un nouvel onglet ; sinon : carte dans une fenêtre #}
            <a href='https://www.google.com/maps/search/?api=1&query=4+Chemin+du+Glais-Malet+51220+Merfy+France'
               target='_blank' rel='noopener' data-carte='carteClub'>
                <p>4 Chemin du Glais-Malet</p>
                <p>51220 Merfy</p>
                <p>{{ 'pied.pays'|trans }}</p>
            </a>
        </div>

        <div class='coord-bloc contact'>
            <h3>{{ 'pied.contact'|trans }}</h3>
            {# Bouton « copier » à droite du texte, qui reste centré #}
            <p class='contact-ligne'>
                <a href='tel:+33675068320'>06 75 06 83 20</a>
                <button type='button' class='bouton-copier' data-copier='+33 6 75 06 83 20' data-copie='{{ 'pied.telephone_copie'|trans }}'
                        aria-label='{{ 'pied.copier_telephone'|trans }}' title='{{ 'pied.copier_telephone'|trans }}'>{{ icone('copier') }}{{ icone('coche') }}</button>
            </p>
            <p class='contact-ligne'>
                <a href='mailto:bultaco.club.france@gmail.com'>bultaco.club.france<wbr>@gmail.com</a>
                <button type='button' class='bouton-copier' data-copier='bultaco.club.france@gmail.com' data-copie='{{ 'pied.email_copie'|trans }}'
                        aria-label='{{ 'pied.copier_email'|trans }}' title='{{ 'pied.copier_email'|trans }}'>{{ icone('copier') }}{{ icone('coche') }}</button>
            </p>
            <p><a href='{{ path('app_demande_piece') }}'>{{ 'demande.encart.pied'|trans }}</a></p>
        </div>

        <div class='coord-bloc reseaux-bloc'>
            <h3>{{ 'pied.reseaux'|trans }}</h3>
            <div class='reseaux-links'>
                <a href="https://www.instagram.com/bultaco_club_france/" class='reseau-item' target='_blank' rel='noopener'>
                    <img src="{{ asset('img/sociale.png') }}" alt='Instagram'>
                    <span>@bultaco_club_france</span>
                </a>
                <a href="https://www.facebook.com/share/g/1Ak8gYsypU/" class='reseau-item' target='_blank' rel='noopener'>
                    <img src="{{ asset('img/facebook.png') }}" alt='Facebook'>
                    <span>{{ 'pied.groupe_facebook'|trans }}</span>
                </a>
            </div>
        </div>
    </div>

    <div class='coord-footer'>
        <p>{{ 'pied.slogan'|trans }}</p>
    </div>
    <a href="{{ path('app_login') }}" class='logorond-link' aria-label='{{ 'pied.espace_admin'|trans }}'>
        <img src="{{ asset('img/logo_rond.png') }}" alt='' class='logorond'>
    </a>
    {# Carte du club : la carte Google n'est chargée qu'à l'ouverture de la fenêtre #}
    <dialog class='carte-dialog' id='carteClub' aria-labelledby='carteClubTitre'>
        <div class='carte-dialog-entete'>
            <h2 id='carteClubTitre'>{{ 'pied.carte_titre'|trans }}</h2>
            <button type='button' class='carte-dialog-fermer' aria-label='{{ 'commun.fermer'|trans }}' data-fermer>&times;</button>
        </div>
        <iframe title='{{ 'pied.carte_titre'|trans }}' allowfullscreen loading='lazy'
                data-src='https://maps.google.com/maps?q=4%20Chemin%20du%20Glais-Malet%2C%2051220%20Merfy%2C%20France&z=15&output=embed&hl={{ app.request.locale }}'></iframe>
        <div class='carte-dialog-actions'>
            {# Itinéraire : c'est Google qui demande la position du visiteur, pas le site #}
            <a href='https://www.google.com/maps/dir/?api=1&destination=4+Chemin+du+Glais-Malet+51220+Merfy+France'
               target='_blank' rel='noopener' class='btn-commander carte-dialog-itineraire'>{{ icone('itineraire') }} {{ 'pied.itineraire'|trans }}</a>
            <a href='https://www.google.com/maps/search/?api=1&query=4+Chemin+du+Glais-Malet+51220+Merfy+France'
               target='_blank' rel='noopener' class='carte-dialog-lien'>{{ 'pied.carte_ouvrir'|trans }} {{ icone('externe') }}</a>
        </div>
    </dialog>
</footer>
{% endblock %}

{# Galerie plein écran, commune à tout le site : ouvrirGalerie(photos, position) dans script.js #}
<dialog class='galerie' id='galerie' aria-label='{{ 'galerie.titre'|trans }}'
        data-compteur='{{ 'galerie.compteur'|trans({ n: '__N__', total: '__TOTAL__' }) }}'>
    <div class='galerie-haut'>
        <p class='galerie-compteur' aria-live='polite'></p>
        <button type='button' class='galerie-fermer' aria-label='{{ 'commun.fermer'|trans }}' data-fermer>&times;</button>
    </div>
    <button type='button' class='galerie-nav galerie-precedente' aria-label='{{ 'galerie.precedente'|trans }}' data-galerie='-1'>{{ icone('chevron-gauche') }}</button>
    <figure class='galerie-figure'>
        <img class='galerie-image' src='' alt=''>
        {# restauration avec ses deux photos : comparateur en grand à la place de l'image #}
        {% include '_partials/_comparateur.html.twig' with { avant: null, apres: null, titre: '', classe: 'galerie-comparateur' } %}
        <figcaption class='galerie-legende'></figcaption>
    </figure>
    <button type='button' class='galerie-nav galerie-suivante' aria-label='{{ 'galerie.suivante'|trans }}' data-galerie='1'>{{ icone('chevron-droite') }}</button>
</dialog>

{# Retour en haut : apparaît après avoir fait défiler (script.js) #}
<button type='button' class='haut-de-page' data-haut-de-page hidden
        aria-label='{{ 'commun.haut_de_page'|trans }}' title='{{ 'commun.haut_de_page'|trans }}'>{{ icone('fleche-haut') }}</button>

{% if is_granted('ROLE_ADMIN') %}
    <a href="{{ path('app_admin') }}" class='admin-shortcut'>⚙ Administration</a>
{% endif %}

{# Textes utilisés par le JavaScript #}
<script>
    window.I18N = {{ {
        ouvrirMenu: 'nav.ouvrir_menu'|trans,
        fermerMenu: 'nav.fermer_menu'|trans,
        ajoute: 'panier.js.ajoute'|trans,
        erreurPanier: 'panier.js.erreur_chargement'|trans,
        selectionAjouter: 'selection.ajouter'|trans,
        selectionRetirer: 'selection.retirer'|trans,
        selectionDans: 'selection.dans'|trans,
        selectionAjoutee: 'selection.ajoutee'|trans,
        selectionRetiree: 'selection.retiree'|trans,
        selectionPleine: 'selection.pleine'|trans,
        locale: { fr: 'fr-FR', en: 'en-GB', es: 'es-ES' }[app.request.locale] ?? 'fr-FR'
    }|json_encode(constant('JSON_HEX_TAG'))|raw }};
</script>
<script src="{{ asset('js/script.js') }}"></script>
<script src="{{ asset('js/panier.js') }}"></script>
<script src="{{ asset('js/compte.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
