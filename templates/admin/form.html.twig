{% extends 'admin/base.html.twig' %}

{% form_theme form 'admin/_form_theme.html.twig' %}

{% set page_title = is_new ? 'Ajouter ' ~ resource.singular : 'Modifier ' ~ resource.singular %}

{% block title %}{{ page_title }} - {{ resource.label }}{% endblock %}
{% block breadcrumb %}
    <a href="{{ path('app_admin') }}">Tableau de bord</a> <span aria-hidden="true">›</span>
    <a href="{{ path('app_admin_list', { resource: resource.key }) }}">{{ resource.label }}</a> <span aria-hidden="true">›</span>
    <span>{{ is_new ? 'Ajout' : 'Modification' }}</span>
{% endblock %}

{% block body %}
    <div class="admin-page-header">
        <div>
            <h1><span aria-hidden="true">{{ resource.icon }}</span> {{ page_title|capitalize }}</h1>
            {% if not is_new and resource.key == 'textes' %}
                {% set info = constant('App\\Admin\\ResourceRegistry::TEXT_SECTIONS')[row.section] ?? null %}
                <p class="admin-page-intro">Page : <strong>{{ info ? info.label : row.section }}</strong>
                    {% if info %} — <a href="{{ path(info.route) }}" target="_blank" rel="noopener">voir la page ↗</a>{% endif %}</p>
            {% endif %}
        </div>
    </div>

    {% if not is_new and resource.detail_template is defined %}
        {% include resource.detail_template %}
    {% endif %}

    {{ form_start(form, { attr: { class: 'admin-form', novalidate: 'novalidate' } }) }}
        {% if not form.vars.valid %}
            <div class="admin-flash admin-flash--error" role="alert"><span>⚠</span> Le formulaire contient des erreurs, vérifiez les champs indiqués en rouge.</div>
        {% endif %}
        {{ form_errors(form) }}

        <div class="admin-form-card">
            {% for name, field in resource.fields %}
                {# les traductions sont affichées sous le champ français #}
                {% if form[name] is defined and field.traduction_de is not defined %}
                    {% if field.type == 'image' %}
                        <div class="admin-image-field">
                            <div class="admin-image-preview" id="preview_{{ name }}">
                                {% if row[name] ?? null %}
                                    <img src="{{ asset(row[name]) }}" alt="Image actuelle" onerror="this.onerror = null; this.parentElement.innerHTML = '<span>Fichier introuvable :<br><code>{{ row[name]|e('js') }}</code></span>';">
                                {% else %}
                                    <span>Aucune image</span>
                                {% endif %}
                            </div>
                            <div class="admin-image-inputs">
                                {{ form_row(form[name], { attr: { 'data-preview': 'preview_' ~ name } }) }}
                                {% if form[name ~ '__remove'] is defined %}{{ form_row(form[name ~ '__remove']) }}{% endif %}
                            </div>
                        </div>
                    {% elseif field.type == 'images' %}
                        <div class="admin-field admin-photos">
                            <span class="admin-photos-titre">{{ field.label }}</span>
                            {% if photos[name] ?? [] is not empty %}
                                <ul class="admin-photos-liste">
                                    {% for photo in photos[name] %}
                                        <li>
                                            <img src="{{ asset(photo.image_path) }}" alt="" loading="lazy">
                                            <label class="admin-photos-ordre">Ordre
                                                <input type="number" name="photos_ordre[{{ name }}][{{ photo.id }}]" value="{{ photo.ordre }}" min="0">
                                            </label>
                                            <label class="admin-photos-supprimer">
                                                <input type="checkbox" name="photos_supprimer[{{ name }}][]" value="{{ photo.id }}"> Supprimer
                                            </label>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                            {{ form_widget(form[name]) }}
                            {{ form_help(form[name]) }}
                            {{ form_errors(form[name]) }}
                        </div>
                    {% elseif field.type == 'multiple' %}
                        <div class="admin-field--multiple">{{ form_row(form[name]) }}</div>
                    {% else %}
                        {{ form_row(form[name]) }}
                    {% endif %}
                    {% if field.traduire ?? false %}
                        <div class="admin-traductions">
                            {% for langue, nom_langue in constant('App\\I18n\\Contenu::TRADUCTIONS') %}
                                {% if form[name ~ '_' ~ langue] is defined %}
                                    <div class="admin-field admin-traduction">
                                        {{ form_label(form[name ~ '_' ~ langue], null, { label_attr: { class: 'admin-traduction-label' } }) }}
                                        {{ form_widget(form[name ~ '_' ~ langue], { attr: { placeholder: 'Vide : le texte français sera affiché', lang: langue } }) }}
                                        {{ form_errors(form[name ~ '_' ~ langue]) }}
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endif %}
                {% endif %}
            {% endfor %}
        </div>

        {{ form_rest(form) }}

        <div class="admin-form-actions">
            <a href="{{ path('app_admin_list', { resource: resource.key }) }}" class="admin-btn admin-btn--ghost">Annuler</a>
            <button type="submit" class="admin-btn">{{ is_new ? 'Ajouter' : 'Enregistrer les modifications' }}</button>
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block javascripts %}
    <script>
        // Aperçu immédiat de l'image choisie
        document.querySelectorAll('input[type=file][data-preview]').forEach(input => {
            input.addEventListener('change', () => {
                const file = input.files[0];
                const preview = document.getElementById(input.dataset.preview);
                if (!file || !file.type.startsWith('image/')) return;
                const img = document.createElement('img');
                img.src = URL.createObjectURL(file);
                img.alt = 'Nouvelle image';
                preview.replaceChildren(img);
                preview.classList.add('is-new');
            });
        });

        // Cases à cocher nombreuses (modèles compatibles) : champ de filtre
        document.querySelectorAll('.admin-field--multiple').forEach(bloc => {
            const choix = bloc.querySelectorAll('.admin-radio');
            if (choix.length < 8) return;
            const filtre = Object.assign(document.createElement('input'), { type: 'search', placeholder: 'Filtrer les modèles…', className: 'admin-multiple-filtre' });
            filtre.addEventListener('input', () => {
                const texte = filtre.value.trim().toLowerCase();
                choix.forEach(c => c.hidden = texte !== '' && !c.textContent.toLowerCase().includes(texte));
            });
            bloc.querySelector('.admin-radios').before(filtre);
        });

        // Avertit avant de quitter la page avec des modifications non enregistrées
        const form = document.querySelector('.admin-form');
        let modifie = false;
        form.addEventListener('input', () => modifie = true);
        form.addEventListener('change', () => modifie = true);
        form.addEventListener('submit', () => modifie = false);
        window.addEventListener('beforeunload', e => { if (modifie) { e.preventDefault(); e.returnValue = ''; } });
    </script>
{% endblock %}
