{% use 'form_div_layout.html.twig' %}

{% block form_row %}
    {%- set row_class = 'admin-field' ~ (errors|length ? ' has-error') ~ (required ? ' is-required') -%}
    <div class="{{ row_class }}">
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{% endblock %}

{% block checkbox_row %}
    <div class="admin-field admin-field--checkbox">
        <label>{{ form_widget(form) }} {{ label|trans({}, translation_domain) }}</label>
        {{- form_errors(form) -}}
    </div>
{% endblock %}

{% block repeated_row %}
    {{- form_errors(form) -}}
    {% for child in form %}{{ form_row(child) }}{% endfor %}
{% endblock %}

{% block form_errors %}
    {%- if errors|length > 0 -%}
        <ul class="admin-field-errors">
            {%- for error in errors -%}<li>{{ error.message }}</li>{%- endfor -%}
        </ul>
    {%- endif -%}
{% endblock %}

{% block form_help %}
    {%- if help is not empty -%}
        <p id="{{ id }}_help" class="admin-field-help">{{ help|trans(help_translation_parameters, translation_domain) }}</p>
    {%- endif -%}
{% endblock %}

{% block choice_widget_expanded %}
    <div {{ block('widget_container_attributes') }} class="admin-radios">
        {%- for child in form %}
            <label class="admin-radio">{{- form_widget(child) -}} <span>{{ child.vars.label|trans({}, choice_translation_domain) }}</span></label>
        {% endfor -%}
    </div>
{% endblock %}

{% block money_widget %}
    <div class="admin-input-suffix">
        {{- block('form_widget_simple') -}}
        <span>€</span>
    </div>
{% endblock %}
