{% set nb_photos = details[0].nb_photos ?? 0 %}
{% set langues = { fr: 'français', en: 'anglais', es: 'espagnol' } %}
<div class="admin-form-card admin-commande admin-demande">
    <div class="admin-commande-infos">
        <div>
            <h2>Demandeur</h2>
            <p><strong>{{ row.nom }}</strong>
               {% if row.client_id %}
                   <a href="{{ path('app_admin_edit', { resource: 'clients', id: row.client_id }) }}" class="admin-badge">compte client</a>
               {% endif %}<br>
               <a href="mailto:{{ row.email }}">{{ row.email }}</a>
               {% if row.telephone %}<br><a href="tel:{{ row.telephone }}">{{ row.telephone }}</a>{% endif %}<br>
               <span class="admin-muted">Langue : {{ langues[row.langue] ?? row.langue }}</span></p>
        </div>
        <div>
            <h2>Moto</h2>
            <p><strong>{{ details[0].modele ?? '—' }}</strong>
               {% if row.annee %}<br>Année : {{ row.annee }}{% endif %}</p>
        </div>
        <div>
            <h2>Demande</h2>
            <p>N° {{ row.id }}<br>Reçue le {{ row.date_demande|date('d/m/Y à H:i') }}
               {% if row.date_reponse %}<br><span class="admin-badge admin-badge--ok">Répondu le {{ row.date_reponse|date('d/m/Y') }}</span>{% endif %}</p>
        </div>
    </div>

    <h2>Pièce recherchée</h2>
    <blockquote class="admin-commande-commentaire">{{ row.description|nl2br }}</blockquote>

    {% if nb_photos > 0 %}
        <h2>Photos</h2>
        <div class="admin-demande-photos">
            {% for numero in 1..nb_photos %}
                {% set url = path('app_admin_demande_photo', { id: row.id, numero: numero }) %}
                <a href="{{ url }}" target="_blank" rel="noopener"><img src="{{ url }}" alt="Photo {{ numero }}" loading="lazy"></a>
            {% endfor %}
        </div>
    {% endif %}

    {% if row.reponse %}
        <p class="admin-muted">Réponse déjà envoyée{{ row.date_reponse ? ' le ' ~ row.date_reponse|date('d/m/Y à H:i') }} : la modifier renverra un e-mail.</p>
    {% endif %}
</div>
