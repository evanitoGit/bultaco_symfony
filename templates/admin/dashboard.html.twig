{% extends 'admin/base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}
{% block breadcrumb %}<span>Tableau de bord</span>{% endblock %}

{% block body %}
    <div class="admin-page-header">
        <div>
            <h1>Bonjour {{ app.user.userIdentifier }} 👋</h1>
            <p class="admin-page-intro">Choisissez ce que vous souhaitez modifier sur le site.</p>
        </div>
    </div>

    {% set vitrine = not vente_ouverte() %}
    <form method="post" action="{{ path('app_admin_boutique_mode') }}"
          class="admin-form-card admin-mode-boutique{{ vitrine ? ' admin-mode-boutique--vitrine' }}"
          onsubmit="return confirm({{ (vitrine ? 'Réactiver la vente en ligne ?' : 'Passer la boutique en mode vitrine ? Les visiteurs ne pourront plus commander.')|json_encode }});">
        <input type="hidden" name="_token" value="{{ csrf_token('boutique_mode') }}">
        <input type="hidden" name="mode" value="{{ vitrine ? 'vente' : 'vitrine' }}">
        <div>
            <h2>{{ vitrine ? '🟡 Boutique : vitrine' : '🟢 Boutique : vente en ligne' }}</h2>
            <p class="admin-muted">
                {{ vitrine
                ? 'Les pièces sont visibles, mais le panier et la commande sont fermés.'
                : 'Les visiteurs peuvent ajouter des pièces au panier et commander.' }}
            </p>
            <label class="admin-mode-prix">
                <input type="checkbox" name="prix" value="1"{{ reglage('vitrine_prix', '1') == '1' ? ' checked' }}>
                Afficher les prix en mode vitrine
            </label>
        </div>
        <button type="submit" class="admin-btn">{{ vitrine ? 'Réactiver la vente' : 'Passer en mode vitrine' }}</button>
    </form>

    {#
        Fonctionnalités en test : chacune peut être désactivée, essayée par les administrateurs
        seulement (sur le vrai site, sans que les visiteurs la voient), ou ouverte à tous.
    #}
    <form method="post" action="{{ path('app_admin_fonctionnalites') }}" class="admin-form-card admin-fonctionnalites" id="fonctionnalites">
        <input type="hidden" name="_token" value="{{ csrf_token('fonctionnalites') }}">
        <div class="admin-fonctionnalites-entete">
            <h2>🧪 Fonctionnalités en test</h2>
            <p class="admin-muted">Essayez une nouveauté sur le vrai site en la réservant aux administrateurs, puis ouvrez-la à tous quand elle vous convient.</p>
        </div>
        {% for nom, info in fonctionnalites %}
            {% set actuel = fonctionnalite_mode(nom) %}
            <fieldset class="admin-fonctionnalite">
                <legend>{{ info.titre }}</legend>
                <p class="admin-muted">{{ info.description }}</p>
                <div class="admin-fonctionnalite-modes" role="radiogroup">
                    {% for mode, libelle in modes_fonctionnalites %}
                        <label class="admin-fonctionnalite-mode admin-fonctionnalite-mode--{{ mode }}">
                            <input type="radio" name="mode[{{ nom }}]" value="{{ mode }}"{{ actuel == mode ? ' checked' }}>
                            <span>{{ libelle }}</span>
                        </label>
                    {% endfor %}
                </div>
            </fieldset>
        {% endfor %}
        <button type="submit" class="admin-btn">Enregistrer</button>
    </form>

    {% for group, resources in groups %}
        <section class="admin-group">
            <h2 class="admin-group-title">{{ group }}</h2>
            <div class="admin-cards">
                {% for key, item in resources %}
                    <article class="admin-card">
                        <a href="{{ path('app_admin_list', { resource: key }) }}" class="admin-card-main">
                            <span class="admin-card-icon" aria-hidden="true">{{ item.icon }}</span>
                            <span class="admin-card-body">
                                <span class="admin-card-title">{{ item.label }}</span>
                                <span class="admin-card-count">{{ counts[key] }} élément{{ counts[key] > 1 ? 's' }}</span>
                            </span>
                        </a>
                        <div class="admin-card-actions">
                            <a href="{{ path('app_admin_list', { resource: key }) }}">Gérer</a>
                            {% if item.can_create ?? true %}
                                <a href="{{ path('app_admin_new', { resource: key }) }}">+ Ajouter</a>
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% endfor %}
{% endblock %}
