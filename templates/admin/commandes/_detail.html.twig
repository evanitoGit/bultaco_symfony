<div class="admin-form-card admin-commande">
    <div class="admin-commande-infos">
        <div>
            <h2>Client</h2>
            <p><strong>{{ row.prenom }} {{ row.nom }}</strong>
               {% if row.client_id %}
                   <a href="{{ path('app_admin_edit', { resource: 'clients', id: row.client_id }) }}" class="admin-badge">compte client</a>
               {% else %}
                   <span class="admin-badge">sans compte</span>
               {% endif %}<br>
               <a href="mailto:{{ row.email }}">{{ row.email }}</a>
               {% if row.telephone %}<br><a href="tel:{{ row.telephone }}">{{ row.telephone }}</a>{% endif %}</p>
        </div>
        <div>
            <h2>Livraison</h2>
            <p>{{ row.adresse }}<br>{{ row.code_postal }} {{ row.ville }}<br>{{ row.pays }}</p>
        </div>
        <div>
            <h2>Paiement</h2>
            <p><strong>{{ { virement: 'Virement', cheque: 'Chèque', carte: 'Carte bancaire' }[row.mode_paiement] ?? row.mode_paiement }}</strong><br>
               Commande du {{ row.date_commande|date('d/m/Y à H:i') }}
               {% if row.date_paiement ?? false %}<br>Payée en ligne le {{ row.date_paiement|date('d/m/Y à H:i') }}{% endif %}</p>
            {% if row.stripe_paiement_id ?? false %}
                {# lien vers le paiement dans le tableau de bord Stripe (remboursement, reçu…) #}
                <p><a href="https://dashboard.stripe.com/{{ stripe_mode_test() ? 'test/' }}payments/{{ row.stripe_paiement_id }}" target="_blank" rel="noopener" class="admin-badge">Voir le paiement sur Stripe {{ icone('externe') }}</a></p>
            {% elseif row.mode_paiement == 'carte' and row.statut == 'en_attente' %}
                <p><span class="admin-badge admin-badge--attente">Paiement par carte non abouti</span></p>
            {% endif %}
            {% if row.stock_restitue ?? false %}
                <p><span class="admin-badge admin-badge--attente">Pièces remises en stock</span></p>
            {% endif %}
        </div>
    </div>

    {% if row.commentaire %}
        <blockquote class="admin-commande-commentaire">{{ row.commentaire|nl2br }}</blockquote>
    {% endif %}

    <table class="admin-table">
        <thead><tr><th>Pièce</th><th>Prix unitaire</th><th>Qté</th><th>Sous-total</th></tr></thead>
        <tbody>
            {% for ligne in details %}
                <tr>
                    <td data-label="Pièce">{{ ligne.nom_piece }}</td>
                    <td data-label="Prix unitaire">{{ ligne.prix_unitaire|number_format(2, ',', ' ') }} €</td>
                    <td data-label="Qté">{{ ligne.quantite }}</td>
                    <td data-label="Sous-total"><strong>{{ (ligne.prix_unitaire * ligne.quantite)|number_format(2, ',', ' ') }} €</strong></td>
                </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr><th colspan="3">Total</th><th>{{ row.total|number_format(2, ',', ' ') }} €</th></tr>
        </tfoot>
    </table>
</div>
