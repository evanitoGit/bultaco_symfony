{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.pressbook'|trans }} - {{ 'meta.suffixe'|trans }}{% endblock %}
{% block meta_description %}{{ 'pressbook.meta'|trans }}{% endblock %}

{% block body_class %}page-press{% endblock %}

{% block body %}
    {% set type_icons = { article: '📰', magazine: '📔', photo: '📸', illustration: '✏️' } %}
    {% set type_labels = { article: 'pressbook.filtre.article'|trans, magazine: 'pressbook.filtre.magazine'|trans, photo: 'pressbook.filtre.photo'|trans, illustration: 'pressbook.filtre.illustration'|trans } %}
    {% set type_badges = { article: 'pressbook.type.article'|trans, magazine: 'pressbook.type.magazine'|trans, photo: 'pressbook.type.photo'|trans, illustration: 'pressbook.type.illustration'|trans } %}

    <div class='head'>
        <h1>{{ 'nav.pressbook'|trans }}</h1>
    </div>

    <div class='container'>
        {% include '_partials/_hero.html.twig' with {
            texte: texte_presentation
        } %}

        <section class='pressbook-section'>
            {% if items is empty %}
                {% include '_partials/_empty.html.twig' with { icone: '📰', message: 'pressbook.aucun'|trans } %}
            {% else %}
                {% if types|length > 1 %}
                    <div class='filtres' role='group' aria-label='{{ 'pressbook.filtrer'|trans }}'>
                        <button type='button' class='filtre active' data-type='tout' aria-pressed='true'>{{ 'pressbook.tout'|trans }}</button>
                        {% for type in types %}
                            <button type='button' class='filtre' data-type='{{ type }}' aria-pressed='false'>
                                {{ type_icons[type] ?? '' }} {{ type_labels[type] ?? type|capitalize }}
                            </button>
                        {% endfor %}
                    </div>
                {% endif %}

                <div class='masonry-grid'>
                    {% for item in items %}
                        <article class='masonry-item' data-id='{{ item.id }}' data-type='{{ item.type_contenu }}' role='button' tabindex='0'
                                 aria-label='{{ 'pressbook.voir'|trans({ nom: item.titre }) }}' onclick='openItemModal({{ item.id }})'>
                            <div class='masonry-media'>
                                {% if item.image_path %}
                                    <img src='{{ asset(item.image_path) }}' alt='{{ item.titre }}' loading='lazy'>
                                {% else %}
                                    <div class='no-image-press' aria-hidden='true'>{{ type_icons[item.type_contenu] ?? '📄' }}</div>
                                {% endif %}
                            </div>
                            <div class='masonry-caption'>
                                <span class='type-badge'>{{ (type_badges[item.type_contenu] ?? item.type_contenu)|upper }}</span>
                                <h3>{{ item.titre }}</h3>
                                {% if item.date_publication or item.source %}
                                    <p class='item-meta'>{{ [item.date_publication, item.source]|filter(v => v)|join(' · ') }}</p>
                                {% endif %}
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </div>

    {% include '_partials/_modal.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const items = {{ items|json_encode(constant('JSON_HEX_TAG'))|raw }};

        const typeLabels = {{ {
            article      : 'pressbook.libelle.article'|trans,
            magazine     : 'pressbook.libelle.magazine'|trans,
            photo        : 'pressbook.libelle.photo'|trans,
            illustration : 'pressbook.libelle.illustration'|trans
        }|json_encode(constant('JSON_HEX_TAG'))|raw }};

        // Filtres par type de document
        document.querySelectorAll('.filtre').forEach(bouton => {
            bouton.addEventListener('click', function () {
                const type = this.dataset.type;
                document.querySelectorAll('.filtre').forEach(b => {
                    b.classList.toggle('active', b === this);
                    b.setAttribute('aria-pressed', b === this);
                });
                document.querySelectorAll('.masonry-item').forEach(item => {
                    item.hidden = type !== 'tout' && item.dataset.type !== type;
                });
            });
        });

        // Galerie : images des documents affichés (selon le filtre choisi), dans l'ordre de la page
        function ouvrirImagesPressbook(id) {
            const visibles = [...document.querySelectorAll('.masonry-item:not([hidden])')].map(el => items.find(i => i.id == el.dataset.id));
            const avecImage = visibles.filter(i => i && i.image_path);
            if (!avecImage.some(i => i.id == id)) avecImage.unshift(items.find(i => i.id == id));
            ouvrirGalerie(avecImage.map(i => ({ src: mediaUrl(i.image_path), legende: i.titre })), avecImage.findIndex(i => i.id == id));
        }

        function openItemModal(id) {
            const item = items.find(i => i.id == id);
            if (!item) return;

            openModal(`
                <div class='press-detail'>
                    <div class='carte-header'>
                        <h2>${escapeHtml(item.titre)}</h2>
                        <span class='badge-modele'>${escapeHtml(typeLabels[item.type_contenu] || item.type_contenu)}</span>
                    </div>
                    ${item.image_path
                        ? `<button type='button' class='press-image-zoom' onclick='ouvrirImagesPressbook(${item.id})' aria-label='{{ 'galerie.agrandir'|trans|e('js') }}'>
                               <img src='${escapeHtml(mediaUrl(item.image_path))}' alt='${escapeHtml(item.titre)}' class='press-image'>
                               <span class='zoom-hint' aria-hidden='true'>{{ icone('agrandir')|e('js') }}</span>
                           </button>`
                        : ''}
                    ${(item.date_publication || item.source) ? `
                    <div class='info-grid'>
                        ${item.date_publication ? `
                        <div class='info-item'>
                            <span class='info-label'>{{ 'pressbook.date'|trans }}</span>
                            <span class='info-value'>${escapeHtml(item.date_publication)}</span>
                        </div>` : ''}
                        ${item.source ? `
                        <div class='info-item'>
                            <span class='info-label'>{{ 'pressbook.source'|trans }}</span>
                            <span class='info-value'>${escapeHtml(item.source)}</span>
                        </div>` : ''}
                    </div>` : ''}
                    ${item.description ? `<div class='press-description'><p>${nl2br(item.description)}</p></div>` : ''}
                    ${item.lien_externe ? `
                    <div class='press-link'>
                        <a href='${escapeHtml(item.lien_externe)}' target='_blank' rel='noopener' class='btn-external'>{{ 'commun.voir_source'|trans }} {{ icone('externe') }}</a>
                    </div>` : ''}
                </div>
            `);
        }

        // arrivée depuis la recherche globale (ou un lien partagé) : l'élément s'ouvre
        ouvrirDepuisAncre(/^#doc-(\d+)$/, openItemModal);
    </script>
{% endblock %}
