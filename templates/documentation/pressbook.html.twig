{% extends 'base.html.twig' %}

{% block title %}Pressbook - Club Bultaco{% endblock %}

{% block body_class %}page-press{% endblock %}

{% block body %}
    {% set type_icons = { article: '📰', magazine: '📔', photo: '📸', illustration: '✏️' } %}

    <div class='head'>
        <h1>Pressbook</h1>
    </div>

    <div class='container'>
        <section class='hero'>
            <p>{{ texte_presentation }}</p>
            {% include '_partials/_search.html.twig' with { placeholder: 'Rechercher un article, un magazine...' } %}
        </section>

        <section class='pressbook-section'>
            {% if items is empty %}
                <p class='no-items'>Aucun élément pour le moment</p>
            {% else %}
                <div class='masonry-grid'>
                    {% for item in items %}
                        <div class='masonry-item' data-id='{{ item.id }}' data-type='{{ item.type_contenu }}' onclick='openItemModal({{ item.id }})'>
                            {% if item.image_path %}
                                <img src='{{ item.image_path }}' alt='{{ item.titre }}' loading='lazy'>
                            {% else %}
                                <div class='no-image-press'>{{ type_icons[item.type_contenu] ?? '📄' }}</div>
                            {% endif %}
                            <div class='masonry-overlay'>
                                <span class='type-badge'>{{ item.type_contenu|upper }}</span>
                                <h3>{{ item.titre }}</h3>
                                {% if item.date_publication %}<p class='item-date'>{{ item.date_publication }}</p>{% endif %}
                                {% if item.source %}<p class='item-source'>{{ item.source }}</p>{% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </div>

    {% include '_partials/_modal.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const items = {{ items|json_encode|raw }};

        const typeLabels = {
            article      : 'Article de presse',
            magazine     : 'Magazine',
            photo        : 'Photographie',
            illustration : 'Illustration'
        };

        window.searchConfig = {
            data       : items,
            fields     : ['description', 'source', 'date_publication', 'type_contenu'],
            labelField : 'titre',
            metaFields : i => [typeLabels[i.type_contenu] || i.type_contenu, i.date_publication, i.source],
            emptyText  : 'Aucun résultat trouvé',
            onSelect   : item => openItemModal(item.id)
        };

        function openItemModal(id) {
            const item = items.find(i => i.id == id);
            if (!item) return;

            openModal(`
                <div class='press-detail'>
                    <div class='press-header'>
                        <h2>${escapeHtml(item.titre)}</h2>
                        <span class='badge-press'>${escapeHtml(typeLabels[item.type_contenu] || item.type_contenu)}</span>
                    </div>
                    ${item.image_path
                        ? `<img src='${escapeHtml(item.image_path)}' alt='${escapeHtml(item.titre)}' class='press-image'>`
                        : `<div class='press-image-placeholder'>Aucune image disponible</div>`}
                    <div class='press-info-grid'>
                        ${item.date_publication ? `
                        <div class='press-info-item'>
                            <span class='press-info-label'>Date :</span>
                            <span class='press-info-value'>${escapeHtml(item.date_publication)}</span>
                        </div>` : ''}
                        ${item.source ? `
                        <div class='press-info-item'>
                            <span class='press-info-label'>Source :</span>
                            <span class='press-info-value'>${escapeHtml(item.source)}</span>
                        </div>` : ''}
                    </div>
                    ${item.description ? `<div class='press-description'><p>${nl2br(item.description)}</p></div>` : ''}
                    ${item.lien_externe ? `
                    <div class='press-link'>
                        <a href='${escapeHtml(item.lien_externe)}' target='_blank' rel='noopener' class='btn-external'>🔗 Voir la source originale</a>
                    </div>` : ''}
                </div>
            `);
        }
    </script>
    <script src="{{ asset('js/search.js') }}"></script>
{% endblock %}
