{% extends 'base.html.twig' %}

{% block title %}Logos - Club Bultaco{% endblock %}
{% block meta_description %}L'évolution des logos Bultaco à travers les décennies.{% endblock %}

{% block body_class %}page-logos{% endblock %}

{% block body %}
    <div class='head'>
        <h1>Logos</h1>
    </div>

    <div class='container'>
        {% include '_partials/_hero.html.twig' with {
            texte: texte_presentation,
            placeholder: 'Rechercher un logo...'
        } %}

        <section class='pressbook-section'>
            {% if logos is empty %}
                {% include '_partials/_empty.html.twig' with { icone: '🎨', message: 'Aucun logo pour le moment' } %}
            {% else %}
                <div class='masonry-grid logos-grid'>
                    {% for logo in logos %}
                        <article class='masonry-item logo-item' data-id='{{ logo.id }}' role='button' tabindex='0'
                                 aria-label='Voir le logo {{ logo.titre }}' onclick='openLogoModal({{ logo.id }})'>
                            <div class='masonry-media'>
                                {% if logo.image_path %}
                                    <img src='{{ logo.image_path }}' alt='{{ logo.titre }}' loading='lazy'>
                                {% else %}
                                    <div class='no-image-press' aria-hidden='true'>🎨</div>
                                {% endif %}
                            </div>
                            <div class='masonry-caption'>
                                <span class='type-badge'>LOGO</span>
                                <h3>{{ logo.titre }}</h3>
                                {% if logo.date_publication or logo.source %}
                                    <p class='item-meta'>{{ [logo.date_publication, logo.source]|filter(v => v)|join(' · ') }}</p>
                                {% endif %}
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </div>

    {% include '_partials/_modal.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const logos = {{ logos|json_encode(constant('JSON_HEX_TAG'))|raw }};

        window.searchConfig = {
            data       : logos,
            fields     : ['description', 'source', 'date_publication'],
            labelField : 'titre',
            metaFields : ['date_publication', 'source'],
            emptyText  : 'Aucun logo trouvé',
            onSelect   : item => openLogoModal(item.id)
        };

        function openLogoModal(id) {
            const logo = logos.find(l => l.id == id);
            if (!logo) return;

            openModal(`
                <div class='press-detail'>
                    <div class='carte-header'>
                        <h2>${escapeHtml(logo.titre)}</h2>
                        <span class='badge-modele'>Logo</span>
                    </div>
                    ${logo.image_path
                        ? `<img src='${escapeHtml(logo.image_path)}' alt='${escapeHtml(logo.titre)}' class='press-image logo-image'>`
                        : `<div class='carte-photo-placeholder'>🎨</div>`}
                    ${(logo.date_publication || logo.source) ? `
                    <div class='info-grid'>
                        ${logo.date_publication ? `
                        <div class='info-item'>
                            <span class='info-label'>Période</span>
                            <span class='info-value'>${escapeHtml(logo.date_publication)}</span>
                        </div>` : ''}
                        ${logo.source ? `
                        <div class='info-item'>
                            <span class='info-label'>Source</span>
                            <span class='info-value'>${escapeHtml(logo.source)}</span>
                        </div>` : ''}
                    </div>` : ''}
                    ${logo.description ? `<div class='press-description'><p>${nl2br(logo.description)}</p></div>` : ''}
                    ${logo.lien_externe ? `
                    <div class='press-link'>
                        <a href='${escapeHtml(logo.lien_externe)}' target='_blank' rel='noopener' class='btn-external'>Voir la source originale ↗</a>
                    </div>` : ''}
                </div>
            `);
        }
    </script>
    <script src="{{ asset('js/search.js') }}"></script>
{% endblock %}
